set -u

[[ $EUID -eq 0 ]] || { echo "Run through systemd or sudo." >&2; exit 1; }
mountpoint -q /data || exit 0

readonly status_file=/run/wasalight-health-status
exec 9>/run/wasalight-health.lock
flock -n 9 || exit 0

write_status() {
    local state=$1 summary=$2 temporary
    temporary=$(mktemp /run/.wasalight-health-status.XXXXXX)
    printf '%s\t%s\t%s\n' "$state" "$(date -Is)" "$summary" >"$temporary"
    chmod 0644 "$temporary"
    mv -f -- "$temporary" "$status_file"
}

write_status CHECKING "check in progress"
output=$(/usr/local/bin/wasalight-health 2>&1)
rc=$?
data=$(awk -F: '$1 == "DATA" {sub(/^[[:space:]]+/, "", $2); print $2; exit}' <<<"$output")
disk=$(awk -F: '$1 == "DISK" {sub(/^[[:space:]]+/, "", $2); print $2; exit}' <<<"$output")
case $rc in
    0)
        write_status OK "system check passed"
        ;;
    1)
        summary="DATA ${data:-unavailable} · DISK ${disk:-unavailable}"
        write_status WARNING "$summary"
        logger -p user.warning -t wasalight-health -- "$summary"
        ;;
    *)
        summary=$(printf '%s' "$output" | tr '\n\t' '  ' | cut -c1-240)
        write_status CHECK_FAILED "${summary:-health command failed}"
        logger -p user.warning -t wasalight-health -- \
            "health check failed with exit code $rc: ${summary:-no output}"
        ;;
esac
exit 0
