#!/usr/bin/env bash
set -u

[[ $EUID -eq 0 ]] || { echo "Run through systemd or sudo." >&2; exit 1; }
mountpoint -q /data || exit 0

install -d -o root -g root -m 0755 /data/system/health
install -d -o chamsys -g chamsys -m 0750 /data/log
output=$(/usr/local/bin/wasalight-health 2>&1)
rc=$?
state=OK
((rc == 0)) || state=WARNING
temporary=$(mktemp /data/system/health/.status.XXXXXX)
trap 'rm -f -- "$temporary"' EXIT
printf '%s\t%s\n' "$state" "$(date -Is)" >"$temporary"
chmod 0644 "$temporary"
mv -f -- "$temporary" /data/system/health/status
trap - EXIT
{
    printf '\n[%s] %s\n' "$(date -Is)" "$state"
    printf '%s\n' "$output"
} >>/data/log/wasalight-health.log
chown chamsys:chamsys /data/log/wasalight-health.log
chmod 0640 /data/log/wasalight-health.log
exit 0
