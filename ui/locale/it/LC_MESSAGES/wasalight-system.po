#: libexec/wasalight-first-run:13
msgid "Welcome to Wasalight"
msgstr "Benvenuto in Wasalight"

#: libexec/wasalight-first-run:14
msgid ""
"<big><b>Initial setup</b></big>\\n\\nThis setup checks network, data, "
