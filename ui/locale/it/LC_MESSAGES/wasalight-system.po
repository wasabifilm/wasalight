msgstr "Backup Companion"

#: installer/templates/rootfs/usr/local/bin/wasalight-rollback-ui:10
msgid ""
"<big><b>MAINTENANCE mode required.</b></big>\\n\\nSwitch to MAINTENANCE and "
"reboot before restoring a snapshot."
msgstr "<big><b>Modalità MAINTENANCE richiesta.</b></big>\\n\\nPassa a MAINTENANCE e riavvia prima di ripristinare uno snapshot."

#: installer/templates/rootfs/usr/local/bin/wasalight-rollback-ui:17
msgid "No Wasalight snapshot is available."
msgstr "Nessuno snapshot Wasalight disponibile."

#: installer/templates/rootfs/usr/local/bin/wasalight-rollback-ui:27
msgid ""
"Select a Wasalight configuration to restore.\\nMagicQ, Ubuntu packages and "
"show data will not be changed."
msgstr "Seleziona una configurazione Wasalight da ripristinare.\\nMagicQ, pacchetti Ubuntu e dati dello show non verranno modificati."

#: installer/templates/rootfs/usr/local/bin/wasalight-rollback-ui:28
msgid "File"
msgstr "File"

#: installer/templates/rootfs/usr/local/bin/wasalight-rollback-ui:28
msgid "Version"
msgstr "Versione"

#: installer/templates/rootfs/usr/local/bin/wasalight-rollback-ui:28
msgid "Date"
msgstr "Data"

#: installer/templates/rootfs/usr/local/bin/wasalight-rollback-ui:29
msgid "Size"
msgstr "Dimensione"

#: installer/templates/rootfs/usr/local/bin/wasalight-rollback-ui:34
msgid "Version:"
msgstr "Versione:"

#: installer/templates/rootfs/usr/local/bin/wasalight-rollback-ui:34
msgid "Date:"
msgstr "Data:"

#: installer/templates/rootfs/usr/local/bin/wasalight-rollback-ui:34
msgid "Size:"
msgstr "Dimensione:"

#: installer/templates/rootfs/usr/local/bin/wasalight-rollback-ui:39
#, sh-printf-format
msgid ""
"<big><b>What do you want to do with this snapshot?</b></"
"big>\\n\\n%s\\n\\nRestore replaces Wasalight configuration, commands and "
"theme. Deletion is permanent."
msgstr "<big><b>Cosa vuoi fare con questo snapshot?</b></big>\\n\\n%s\\n\\nIl ripristino sostituisce configurazione, comandi e tema Wasalight. L’eliminazione è definitiva."

#: installer/templates/rootfs/usr/local/bin/wasalight-rollback-ui:40
msgid "Restore"
msgstr "Ripristina"

#: installer/templates/rootfs/usr/local/bin/wasalight-rollback-ui:41
#: installer/templates/rootfs/usr/local/bin/wasalight-rollback-ui:45
msgid "Delete snapshot"
msgstr "Elimina snapshot"

#: installer/templates/rootfs/usr/local/bin/wasalight-rollback-ui:47
#, sh-printf-format
msgid ""
"<big><b>Permanently delete this snapshot?</b></big>\\n\\n%s\\n\\nThe file "
"and its checksum will be removed from /data and cannot be recovered."
msgstr "<big><b>Eliminare definitivamente questo snapshot?</b></big>\\n\\n%s\\n\\nIl file e il relativo checksum verranno rimossi da /data e non potranno essere recuperati."

#: installer/templates/rootfs/usr/local/bin/wasalight-rollback-ui:48
msgid "Delete permanently"
msgstr "Elimina definitivamente"

#: installer/templates/rootfs/usr/local/bin/wasalight-rollback-ui:48
msgid "Keep"
msgstr "Conserva"

#: installer/templates/rootfs/usr/local/bin/wasalight-rollback-ui:53
#, sh-printf-format
msgid "<big><b>Snapshot deleted.</b></big>\\n\\n%s"
msgstr "<big><b>Snapshot eliminato.</b></big>\\n\\n%s"

#: installer/templates/rootfs/usr/local/bin/wasalight-rollback-ui:57
msgid "<big><b>Deletion failed.</b></big>\\n\\nThe snapshot was kept."
msgstr "<big><b>Eliminazione non riuscita.</b></big>\\n\\nLo snapshot è stato conservato."

#: installer/templates/rootfs/usr/local/bin/wasalight-rollback-ui:65
msgid ""
"<big><b>Snapshot integrity check failed.</b></big>\\n\\nThe checksum is "
"invalid, so restore was blocked. You can still delete the snapshot from the "
"previous menu."
msgstr "<big><b>Controllo di integrità dello snapshot non riuscito.</b></big>\\n\\nIl checksum non è valido, quindi il ripristino è stato bloccato. Puoi comunque eliminare lo snapshot dal menu precedente."

#: installer/templates/rootfs/usr/local/bin/wasalight-rollback-ui:76
msgid "Restoring configuration…"
msgstr "Ripristino della configurazione in corso…"

#: installer/templates/rootfs/usr/local/bin/wasalight-rollback-ui:88
#, sh-printf-format
msgid "<big><b>Rollback failed.</b></big>\\n\\n%s"
msgstr "<big><b>Rollback non riuscito.</b></big>\\n\\n%s"

#: installer/templates/rootfs/usr/local/bin/wasalight-rollback-ui:94
msgid "<big><b>Configuration restored.</b></big>\\n\\nRestart now to apply it?"
msgstr "<big><b>Configurazione ripristinata.</b></big>\\n\\nRiavviare ora per applicarla?"

#: installer/templates/rootfs/usr/local/libexec/wasalight-companion-update-session:8
msgid "Updates are allowed only in MAINTENANCE mode."
msgstr "Gli aggiornamenti sono consentiti solo in modalità MAINTENANCE."

#: installer/templates/rootfs/usr/local/libexec/wasalight-companion-update-session:10
msgid ""
"Authorize the operation in the graphical window using the chamsys password."
msgstr ""
"Autorizza l’operazione nella finestra grafica usando la password di chamsys."

#: installer/templates/rootfs/usr/local/libexec/wasalight-companion-update-session:17
msgid "Companion update completed."
msgstr "Aggiornamento Companion completato."

#: installer/templates/rootfs/usr/local/libexec/wasalight-companion-update-session:20
msgid "Authentication cancelled: Companion was not modified."
msgstr "Autenticazione annullata: Companion non è stato modificato."

#: installer/templates/rootfs/usr/local/libexec/wasalight-companion-update-session:23
#, sh-printf-format
msgid "Companion update failed (exit code %s)."
