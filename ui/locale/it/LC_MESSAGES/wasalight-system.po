msgid "Power off Wasalight"
msgstr "Spegni Wasalight"

msgid "Shut down the workstation completely?"
msgstr "Spegnere completamente la postazione?"

msgid "Power off"
msgstr "Spegni"

msgid "Restart Wasalight"
msgstr "Riavvia Wasalight"

msgid "Restart the workstation now?"
msgstr "Riavviare adesso la postazione?"

msgid "Restart"
msgstr "Riavvia"

msgid "Usage: wasalight-power poweroff|reboot"
msgstr "Uso: wasalight-power poweroff|reboot"

msgid "Shows saved in /data will remain persistent."
msgstr "Gli show salvati in /data resteranno persistenti."

msgid "Cancel"
msgstr "Annulla"

msgid "Files"
msgstr "File"

msgid "Terminal"
msgstr "Terminale"

msgid "Update Wasalight"
msgstr "Aggiorna Wasalight"

msgid "--channel requires stable or debug"
msgstr "--channel richiede stable o debug"

msgid "--plugin requires an ID"
msgstr "--plugin richiede un ID"

msgid "An incomplete update is present."
msgstr "È presente un aggiornamento incompleto."

msgid "Authentication cancelled: Wasalight was not modified."
msgstr "Autenticazione annullata: Wasalight non è stato modificato."

msgid "Authentication was cancelled."
msgstr "L’autenticazione è stata annullata."

msgid "Channel:"
msgstr "Canale:"

msgid "Check: /data/log/wasalight/updates/"
msgstr "Controlla: /data/log/wasalight/updates/"

msgid "Close"
msgstr "Chiudi"

msgid "Continue"
msgstr "Continua"

msgid "Download, verify and install the latest version."
msgstr "Scarico, verifico e installo l’ultima versione."

msgid "Later"
msgstr "Più tardi"

msgid "MagicQ is not installed."
msgstr "MagicQ non è installato."

msgid "MagicQ not installed"
msgstr "MagicQ non installato"

msgid "No changes were applied and no reboot is required."
msgstr "Non sono state applicate modifiche e non serve riavviare."

msgid "Only one recovery operation may be requested."
msgstr "È possibile richiedere una sola operazione di recupero."

msgid "Remember to restart before the next use."
msgstr "Ricordati di riavviare prima del prossimo utilizzo."

msgid "Restart now"
msgstr "Riavvia ora"

msgid "Restart now to apply the new configuration?"
msgstr "Riavviare ora per applicare la nuova configurazione?"

msgid "Restarting…"
msgstr "Riavvio in corso…"

msgid "Resume"
msgstr "Riprendi"

msgid "Resume the verified transaction now?"
msgstr "Riprendere ora la transazione verificata?"

msgid "Status: %s"
msgstr "Stato: %s"

msgid "The full log remains available with the compact view."
msgstr "Il log completo resta disponibile anche con la vista compatta."

msgid "The machine will not restart."
msgstr "La macchina non verrà riavviata."

msgid "The requested password is the Linux password for chamsys."
msgstr "La password richiesta è quella Linux di chamsys."

msgid "The system is already up to date."
msgstr "Il sistema è già aggiornato."

msgid "The system is already up to date; no reboot is required."
msgstr "Il sistema è già aggiornato; nessun riavvio necessario."

msgid ""
"The update will still search for a valid package in /data and on USB drives. "
"If none is found, do you want to update only Wasalight and the other "
"components?"
msgstr ""
"L’aggiornamento cercherà comunque un pacchetto valido in /data e nelle USB. "
"Se non lo trova, vuoi aggiornare soltanto Wasalight e gli altri componenti?"

msgid "Unknown option"
msgstr "Opzione sconosciuta"

msgid "Unknown plugin"
msgstr "Plugin sconosciuto"

msgid "Unknown update channel"
msgstr "Canale di aggiornamento sconosciuto"

msgid "Update cancelled"
msgstr "Aggiornamento annullato"

msgid "Update completed successfully."
msgstr "Aggiornamento completato correttamente."

msgid "Update completed."
msgstr "Aggiornamento completato."

msgid "Update failed"
msgstr "Aggiornamento non riuscito"

msgid "Update installed."
msgstr "Aggiornamento installato."

msgid "Update interrupted"
msgstr "Aggiornamento interrotto"

msgid "Update not completed. The machine will not restart."
msgstr "Aggiornamento non completato. La macchina non verrà riavviata."

msgid ""
"Usage: wasalight-update-terminal [--channel stable|debug] [--resume|--"
"repair|--rollback] [--plugin ID]"
msgstr ""
"Uso: wasalight-update-terminal [--channel stable|debug] [--resume|--repair|--"
"rollback] [--plugin ID]"

msgid "Waiting for authorization…"
msgstr "In attesa dell’autorizzazione…"

msgid "Wasalight Update"
msgstr "Aggiornamento Wasalight"

msgid "Wasalight updated"
msgstr "Wasalight aggiornato"

msgid "Wasalight was not modified."
msgstr "Wasalight non è stato modificato."

msgid "Wasalight was not updated."
msgstr "Wasalight non è stato aggiornato."

#: installer/templates/rootfs/usr/local/bin/wasalight-control:27
#, sh-printf-format
msgid ""
"<big><b>Wasalight Control could not start.</b></big>\\n\\n%s\\n\\nLog: %s"
msgstr "<big><b>Impossibile avviare Wasalight Control.</b></big>\\n\\n%s\\n\\nLog: %s"

#: installer/templates/rootfs/usr/local/bin/wasalight-keyboard-toggle:13
msgid "On-screen keyboard unavailable"
msgstr "Tastiera virtuale non disponibile"

#: installer/templates/rootfs/usr/local/bin/wasalight-keyboard-toggle:14
msgid "The Onboard package is not installed."
msgstr "Il pacchetto Onboard non è installato."

#: installer/templates/rootfs/usr/local/bin/wasalight-magicq-install-ui:10
msgid ""
"<big><b>MagicQ installation is already running.</b></big>\\n\\nWait for the "
"current search, copy and verification to finish."
msgstr ""
"<big><b>L’installazione di MagicQ è già in corso.</b></big>\\n\\nAttendi che "
"la ricerca, la copia e la verifica correnti siano terminate."

#: installer/templates/rootfs/usr/local/bin/wasalight-magicq-install-ui:21
msgid ""
"<big><b>MAINTENANCE mode required.</b></big>\\n\\nSwitch to MAINTENANCE and "
"reboot, then try the MagicQ installation again."
msgstr "<big><b>Modalità MAINTENANCE richiesta.</b></big>\\n\\nPassa a MAINTENANCE e riavvia, poi ripeti l’installazione di MagicQ."

#: installer/templates/rootfs/usr/local/bin/wasalight-magicq-install-ui:19
msgid ""
"<big><b>Install or update MagicQ?</b></big>\\n\\nInsert a USB drive "
"containing the MagicQ package in its root or packages folder. This works "
"without Internet and does not update Wasalight."
msgstr "<big><b>Installare o aggiornare MagicQ?</b></big>\\n\\nInserisci una chiavetta con il pacchetto MagicQ nella root o nella cartella packages. L’operazione funziona senza Internet e non aggiorna Wasalight."

#: installer/templates/rootfs/usr/local/bin/wasalight-magicq-install-ui:20
msgid "Find and install"
msgstr "Cerca e installa"

#: installer/templates/rootfs/usr/local/bin/wasalight-magicq-install-ui:40
msgid "Searching, copying and verifying MagicQ… A slow USB drive can take several minutes."
msgstr "Ricerca, copia e verifica di MagicQ… Una chiavetta lenta può richiedere diversi minuti."

#: installer/templates/rootfs/usr/local/bin/wasalight-magicq-install-ui:45
#, sh-printf-format
msgid "<big><b>MagicQ installation failed.</b></big>\\n\\n%s"
msgstr "<big><b>Installazione MagicQ non riuscita.</b></big>\\n\\n%s"

#: installer/templates/rootfs/usr/local/bin/wasalight-magicq-install-ui:51
#, sh-printf-format
msgid "<big><b>MagicQ is ready.</b></big>\\n\\n%s"
msgstr "<big><b>MagicQ è pronto.</b></big>\\n\\n%s"

#: installer/templates/rootfs/usr/local/bin/wasalight-mode-toggle:14
msgid ""
"The next boot will use the writable filesystem for updates and maintenance."
msgstr ""
"Il prossimo avvio userà il filesystem scrivibile per aggiornamenti e "
"manutenzione."

#: installer/templates/rootfs/usr/local/bin/wasalight-mode-toggle:18
msgid "The next boot will use overlayroot protection for the show."
msgstr "Il prossimo avvio userà la protezione overlayroot per lo show."

#: installer/templates/rootfs/usr/local/bin/wasalight-mode-toggle:22
#, sh-printf-format
msgid "%s mode · Wasalight"
msgstr "Modalità %s · Wasalight"

#: installer/templates/rootfs/usr/local/bin/wasalight-mode-toggle:23
#, sh-printf-format
msgid ""
"<big><b>Prepare %s mode?</b></big>\\n\\n%s\\n\\nThe mode will change only "
"after rebooting."
msgstr "<big><b>Preparare la modalità %s?</b></big>\\n\\n%s\\n\\nLa modalità cambierà soltanto dopo il riavvio."

#: installer/templates/rootfs/usr/local/bin/wasalight-mode-toggle:24
#, sh-printf-format
msgid "Prepare %s"
msgstr "Prepara %s"

#: installer/templates/rootfs/usr/local/bin/wasalight-mode-toggle:28
msgid "Wasalight mode"
msgstr "Modalità Wasalight"

#: installer/templates/rootfs/usr/local/bin/wasalight-mode-toggle:34
#, sh-printf-format
msgid "%s ready · Wasalight"
msgstr "%s pronto · Wasalight"

#: installer/templates/rootfs/usr/local/bin/wasalight-mode-toggle:35
#, sh-printf-format
msgid "<big><b>%s mode is ready.</b></big>\\n\\nRestart now to apply it?"
msgstr "<big><b>Modalità %s preparata.</b></big>\\n\\nRiavviare adesso per applicarla?"

#: installer/templates/rootfs/usr/local/bin/wasalight-remote-auto-toggle:18
#, sh-printf-format
msgid ""
"Disable automatic startup for %s?\\n\\nThe running service will not be "
"stopped."
msgstr "Disabilitare l’avvio automatico di %s?\\n\\nIl servizio corrente non verrà fermato."

#: installer/templates/rootfs/usr/local/bin/wasalight-remote-auto-toggle:19
msgid "Disable automatic startup"
msgstr "Disabilita avvio automatico"

#: installer/templates/rootfs/usr/local/bin/wasalight-remote-auto-toggle:22
#, sh-printf-format
msgid "Enable automatic startup for %s after every reboot?"
msgstr "Abilitare l’avvio automatico di %s dopo ogni riavvio?"

#: installer/templates/rootfs/usr/local/bin/wasalight-remote-auto-toggle:23
msgid "Enable automatic startup"
msgstr "Abilita avvio automatico"

#: installer/templates/rootfs/usr/local/bin/wasalight-screen-lock:15
msgid "Lock screen · Wasalight"
msgstr "Blocca schermo · Wasalight"

#: installer/templates/rootfs/usr/local/bin/wasalight-screen-lock:16
msgid ""
"<big><b>Lock the screen now?</b></big>\\n\\nUnlocking requires the Linux "
"password for chamsys and a keyboard.\\nThe display will stay on: suspend, "
"screensaver and DPMS remain disabled."
msgstr "<big><b>Bloccare lo schermo adesso?</b></big>\\n\\nLo sblocco richiede la password Linux di chamsys e una tastiera.\\nIl display resterà acceso: sospensione, salvaschermo e DPMS rimangono disattivati."

#: installer/templates/rootfs/usr/local/bin/wasalight-screen-lock:17
msgid "Lock"
msgstr "Blocca"

#: installer/templates/rootfs/usr/local/bin/wasalight-ssh-toggle:16
msgid "Note: SSH is configured to start again on the next boot."
msgstr "Nota: SSH è configurato per riattivarsi al prossimo avvio."

#: installer/templates/rootfs/usr/local/bin/wasalight-ssh-toggle:20
#, sh-printf-format
msgid ""
"<big><b>SSH is active.</b></big>\\n\\nAddress: ssh://"
"chamsys@%s:22%s\\n\\nStop SSH access now?"
msgstr "<big><b>SSH è attivo.</b></big>\\n\\nIndirizzo: ssh://chamsys@%s:22%s\\n\\nFermare ora l’accesso SSH?"

#: installer/templates/rootfs/usr/local/bin/wasalight-ssh-toggle:21
msgid "Stop SSH"
msgstr "Ferma SSH"

#: installer/templates/rootfs/usr/local/bin/wasalight-ssh-toggle:32
msgid ""
"<big><b>Enable SSH?</b></big>\\n\\nAccess will use the chamsys account and "
"its Linux password. Enable it only on a trusted network."
msgstr "<big><b>Attivare SSH?</b></big>\\n\\nL’accesso userà l’utente chamsys e la sua password Linux. Attivarlo soltanto su una rete fidata."

#: installer/templates/rootfs/usr/local/bin/wasalight-ssh-toggle:33
msgid "Start SSH"
msgstr "Avvia SSH"

#: installer/templates/rootfs/usr/local/bin/wasalight-ssh-toggle:40
#, sh-printf-format
msgid ""
"<big><b>SSH active</b></big>\\n\\nAddress: ssh://chamsys@%s:22\\nUser: "
"chamsys\\nPassword: the Linux password for chamsys"
msgstr "<big><b>SSH attivo</b></big>\\n\\nIndirizzo: ssh://chamsys@%s:22\\nUtente: chamsys\\nPassword: la password Linux di chamsys"

#: installer/templates/rootfs/usr/local/bin/wasalight-vnc-toggle:14
msgid "<big><b>VNC is active.</b></big>\\n\\nStop sharing the current session?"
msgstr "<big><b>VNC è attivo.</b></big>\\n\\nFermare la condivisione della sessione corrente?"

#: installer/templates/rootfs/usr/local/bin/wasalight-vnc-toggle:15
msgid "Stop VNC"
msgstr "Ferma VNC"

#: installer/templates/rootfs/usr/local/bin/wasalight-vnc-toggle:29
#: installer/templates/rootfs/usr/local/libexec/wasalight-companion-update-session:25
msgid "Press Enter to close."
msgstr "Premi Invio per chiudere."

#: installer/templates/rootfs/usr/local/bin/wasalight-vnc-toggle:30
msgid "VNC password · Wasalight"
msgstr "Password VNC · Wasalight"

#: installer/templates/rootfs/usr/local/bin/wasalight-vnc-toggle:41
#, sh-printf-format
msgid ""
"<big><b>VNC active in the current session</b></big>\\n\\nAddress: vnc://"
"%s:5900\\n\\nUse it only on a trusted local network."
msgstr "<big><b>VNC attivo nella sessione corrente</b></big>\\n\\nIndirizzo: vnc://%s:5900\\n\\nUsare soltanto su una rete locale fidata."

#: installer/templates/rootfs/usr/local/bin/wasalight-update-check:77
