<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Wasabi Lightbulbfarm</vendor>
  <vendor_url>https://github.com/wasabifilm/wasalight</vendor_url>

  <action id="com.wasalight.magicq-network.apply">
    <description>Sincronizza la rete Linux con MagicQ</description>
    <message>Autorizza la sincronizzazione dell’indirizzo di rete MagicQ</message>
    <icon_name>network-wired</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/wasalight-magicq-network</annotate>
  </action>
</policyconfig>
