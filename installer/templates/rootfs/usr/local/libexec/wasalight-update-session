#!/usr/bin/env bash
# Copyright 2026 Michele Moser
# SPDX-License-Identifier: Apache-2.0
set -u
. "${WASALIGHT_I18N_HELPER:-/usr/local/libexec/wasalight-i18n}"

# The minimal Openbox session does not run the AT-SPI accessibility bus.
# Disable GTK accessibility only for this small update UI so Zenity does not
# print a harmless GDBus warning after a successful installation.
export GTK_A11Y=none

update_args=()
if [[ -n ${WASALIGHT_UPDATE_PLUGIN:-} ]]; then
    update_args+=(--plugin "$WASALIGHT_UPDATE_PLUGIN")
fi
if [[ -n ${WASALIGHT_UPDATE_CHANNEL:-} ]]; then
    update_args+=(--channel "$WASALIGHT_UPDATE_CHANNEL")
fi
if [[ -n ${WASALIGHT_UPDATE_OPERATION:-} ]]; then
    update_args+=("$WASALIGHT_UPDATE_OPERATION")
fi

# A console used only for Wasalight/Companion development may intentionally
# have no MagicQ package yet.  The command-line updater keeps this as an
# explicit safety choice; the graphical launcher asks for that choice here and
# forwards the corresponding option after confirmation.
installed_magicq=$(dpkg-query -W -f='${db:Status-Abbrev}' magicq 2>/dev/null || true)
if [[ $installed_magicq != ii* ]]; then
    missing_title=$( _ "MagicQ not installed" )
    missing_heading=$( _ "MagicQ is not installed." )
    missing_detail=$( _ "The update will still search for a valid package in /data and on USB drives. If none is found, do you want to update only Wasalight and the other components?" )
    if /usr/local/bin/wasalight-dialog --question \
        --icon=system-software-update --width=560 --title="$missing_title" \
        --text="<big><b>$missing_heading</b></big>\n\n$missing_detail" \
        --ok-label="$( _ "Continue" )" --cancel-label="$( _ "Cancel" )"; then
        update_args+=(--allow-missing-magicq)
    else
        exit 0
    fi
fi

transaction_status=$(awk -F= '$1 == "status" {print $2; exit}' \
    /data/system/update-state 2>/dev/null || true)
if [[ -z ${WASALIGHT_UPDATE_OPERATION:-} && \
      ( $transaction_status == running || $transaction_status == failed ) ]]; then
    interrupted_title=$( _ "Update interrupted" )
    interrupted_heading=$( _ "An incomplete update is present." )
    printf -v interrupted_status "$( _ "Status: %s" )" "$transaction_status"
    interrupted_question=$( _ "Resume the verified transaction now?" )
    if /usr/local/bin/wasalight-dialog --question \
        --icon=system-software-update --width=560 --title="$interrupted_title" \
        --text="<big><b>$interrupted_heading</b></big>\n\n$interrupted_status\n\n$interrupted_question" \
        --ok-label="$( _ "Resume" )" --cancel-label="$( _ "Close" )"; then
        update_args+=(--resume)
    else
        exit 0
    fi
fi
display_channel=${WASALIGHT_UPDATE_CHANNEL:-$(cat /data/system/update-channel 2>/dev/null || echo stable)}

if [[ -t 1 ]]; then
    brand=$'\033[1;38;2;118;189;34m'
    white=$'\033[1;37m'
    muted=$'\033[38;5;245m'
    reset=$'\033[0m'
else
    brand= white= muted= reset=
fi
clear
printf '%s┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓%s\n' "$brand" "$reset"
printf '%s┃%s  %s%-52s%s%s┃%s\n' \
    "$brand" "$reset" "$white" 'WASALIGHT UPDATE' "$reset" "$brand" "$reset"
printf '%s┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛%s\n\n' "$brand" "$reset"
printf '  %s●%s %s\n' "$brand" "$reset" \
    "$( _ "Download, verify and install the latest version." )"
printf '  %s●%s %s %s.\n' "$brand" "$reset" "$( _ "Channel:" )" "$display_channel"
printf '  %s●%s %s\n' "$brand" "$reset" \
    "$( _ "The full log remains available with the compact view." )"
printf '  %s●%s %s\n\n' "$brand" "$reset" \
    "$( _ "The requested password is the Linux password for chamsys." )"
printf '  %s%s%s\n\n' "$muted" "$( _ "Waiting for authorization…" )" "$reset"

pkexec /usr/local/sbin/wasalight-update "${update_args[@]}"
rc=$?
if ((rc == 0)); then
    echo
    if [[ ! -e /run/wasalight-update-reboot-required ]]; then
        _ "The system is already up to date; no reboot is required."
        printf '\n'
        /usr/local/bin/wasalight-dialog --info --width=520 \
            --title="$( _ "Wasalight updated" )" \
            --text="<big><b>$( _ "The system is already up to date." )</b></big>\n\n$( _ "No changes were applied and no reboot is required." )" \
            --ok-label="$( _ "Close" )"
        exit 0
    fi
    _ "Update completed successfully."
    printf '\n'
    if /usr/local/bin/wasalight-dialog --question \
        --icon=/usr/local/share/icons/wasalight/reboot.svg --width=520 \
        --title="$( _ "Wasalight updated" )" \
        --text="<big><b>$( _ "Update completed." )</b></big>\n\n$( _ "Restart now to apply the new configuration?" )" \
        --ok-label="$( _ "Restart now" )" --cancel-label="$( _ "Later" )"; then
        _ "Restarting…"
        printf '\n'
        sudo -n /usr/local/sbin/wasalight-power-control reboot
        exit $?
    fi
    /usr/local/bin/wasalight-dialog --info --width=500 \
        --title="$( _ "Wasalight updated" )" \
        --text="$( _ "Update installed." )\n\n$( _ "Remember to restart before the next use." )" \
        --ok-label="$( _ "Close" )"
    exit 0
fi

if ((rc == 126)); then
    echo
    _ "Authentication cancelled: Wasalight was not modified."
    printf '\n'
    /usr/local/bin/wasalight-dialog --info --width=500 \
        --title="$( _ "Update cancelled" )" \
        --text="$( _ "Authentication was cancelled." )\n\n$( _ "Wasalight was not modified." )" \
        --ok-label="$( _ "Close" )" 2>/dev/null || true
    exit 126
fi

echo
_ "Update not completed. The machine will not restart."
printf '\n'
/usr/local/bin/wasalight-dialog --error --width=560 \
    --title="$( _ "Update failed" )" \
    --text="<big><b>$( _ "Wasalight was not updated." )</b></big>\n\n$( _ "The machine will not restart." )\n$( _ "Check: /data/log/wasalight/updates/" )" \
    --ok-label="$( _ "Close" )" 2>/dev/null || true
exit "$rc"
