#!/usr/bin/env bash
# Copyright 2026 Michele Moser
# SPDX-License-Identifier: Apache-2.0
set -u

# The minimal Openbox session does not run the AT-SPI accessibility bus.
# Disable GTK accessibility only for this small update UI so Zenity does not
# print a harmless GDBus warning after a successful installation.
export GTK_A11Y=none

update_args=()
if [[ -n ${WASALIGHT_UPDATE_PLUGIN:-} ]]; then
    update_args+=(--plugin "$WASALIGHT_UPDATE_PLUGIN")
fi
if [[ -n ${WASALIGHT_UPDATE_CHANNEL:-} ]]; then
    update_args+=(--channel "$WASALIGHT_UPDATE_CHANNEL")
fi
if [[ -n ${WASALIGHT_UPDATE_OPERATION:-} ]]; then
    update_args+=("$WASALIGHT_UPDATE_OPERATION")
fi

transaction_status=$(awk -F= '$1 == "status" {print $2; exit}' \
    /data/system/update-state 2>/dev/null || true)
if [[ -z ${WASALIGHT_UPDATE_OPERATION:-} && \
      ( $transaction_status == running || $transaction_status == failed ) ]]; then
    if /usr/local/bin/wasalight-dialog --question \
        --icon=system-software-update --width=560 --title="Aggiornamento interrotto" \
        --text="<big><b>È presente un aggiornamento incompleto.</b></big>\n\nStato: $transaction_status\n\nRiprendere ora la transazione verificata?" \
        --ok-label="Riprendi" --cancel-label="Chiudi"; then
        update_args+=(--resume)
    else
        exit 0
    fi
fi
display_channel=${WASALIGHT_UPDATE_CHANNEL:-$(cat /data/system/update-channel 2>/dev/null || echo stable)}

if [[ -t 1 ]]; then
    brand=$'\033[1;38;2;118;189;34m'
    white=$'\033[1;37m'
    muted=$'\033[38;5;245m'
    reset=$'\033[0m'
else
    brand= white= muted= reset=
fi
clear
printf '%s┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓%s\n' "$brand" "$reset"
printf '%s┃%s  %sWASALIGHT UPDATE%s                                  %s┃%s\n' \
    "$brand" "$reset" "$white" "$reset" "$brand" "$reset"
printf '%s┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛%s\n\n' "$brand" "$reset"
printf '  %s●%s Scarico, verifico e installo l’ultima versione.\n' "$brand" "$reset"
printf '  %s●%s Canale: %s.\n' "$brand" "$reset" "$display_channel"
printf '  %s●%s Il log completo resta disponibile anche con la vista compatta.\n' "$brand" "$reset"
printf '  %s●%s La password richiesta è quella Linux di chamsys.\n\n' "$brand" "$reset"
printf '  %sIn attesa dell’autorizzazione…%s\n\n' "$muted" "$reset"

pkexec /usr/local/sbin/wasalight-update "${update_args[@]}"
rc=$?
if ((rc == 0)); then
    echo
    if [[ ! -e /run/wasalight-update-reboot-required ]]; then
        echo "Il sistema è già aggiornato; nessun riavvio necessario."
        /usr/local/bin/wasalight-dialog --info --width=520 --title="Wasalight aggiornato" \
            --text="<big><b>Il sistema è già aggiornato.</b></big>\n\nNon sono state applicate modifiche e non serve riavviare." \
            --ok-label="Chiudi"
        exit 0
    fi
    echo "Aggiornamento completato correttamente."
    if /usr/local/bin/wasalight-dialog --question \
        --icon=/usr/local/share/icons/wasalight/reboot.svg --width=520 --title="Wasalight aggiornato" \
        --text="<big><b>Aggiornamento completato.</b></big>\n\nRiavviare ora per applicare la nuova configurazione?" \
        --ok-label="Riavvia ora" --cancel-label="Più tardi"; then
        echo "Riavvio in corso…"
        sudo -n /usr/local/sbin/wasalight-power-control reboot
        exit $?
    fi
    /usr/local/bin/wasalight-dialog --info --width=500 --title="Wasalight aggiornato" \
        --text="Aggiornamento installato.\n\nRicordati di riavviare prima del prossimo utilizzo." \
        --ok-label="Chiudi"
    exit 0
fi

if ((rc == 126)); then
    echo
    echo "Autenticazione annullata: Wasalight non è stato modificato."
    /usr/local/bin/wasalight-dialog --info --width=500 --title="Aggiornamento annullato" \
        --text="L’autenticazione è stata annullata.\n\nWasalight non è stato modificato." \
        --ok-label="Chiudi" 2>/dev/null || true
    exit 126
fi

echo
echo "Aggiornamento non completato. La macchina non verrà riavviata."
/usr/local/bin/wasalight-dialog --error --width=560 --title="Aggiornamento non riuscito" \
    --text="<big><b>Wasalight non è stato aggiornato.</b></big>\n\nLa macchina non verrà riavviata.\nControlla: /data/log/wasalight-update.log" \
    --ok-label="Chiudi" 2>/dev/null || true
exit "$rc"
