set -u
clear
echo "BITFOCUS COMPANION UPDATE"
echo "Gli aggiornamenti sono consentiti solo in modalità MAINTENANCE."
echo "Autorizza l’operazione nella finestra grafica con la password di chamsys."
echo
pkexec /usr/local/sbin/wasalight-companion-update
rc=$?
echo
if ((rc == 0)); then
    echo "Aggiornamento Companion completato."
elif ((rc == 126)); then
    echo "Autenticazione annullata: Companion non è stato modificato."
else
    echo "Aggiornamento Companion non riuscito (codice $rc)."
fi
echo "Premi Invio per chiudere."
read -r _
exit "$rc"
