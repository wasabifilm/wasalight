#!/usr/bin/env bash
# Copyright 2026 Michele Moser
# SPDX-License-Identifier: Apache-2.0
set -Eeuo pipefail
[[ $EUID -eq 0 ]] || { echo "Run through sudo." >&2; exit 1; }

channel=${1:-}
case $channel in
    stable|debug) ;;
    *) echo "Usage: wasalight-update-channel stable|debug" >&2; exit 2 ;;
esac
mountpoint -q /data || { echo "/data is not mounted." >&2; exit 1; }

state_root=/data/system
channel_file=$state_root/update-channel
check_root=$state_root/update-check
install -d -o root -g root -m 0755 "$state_root"
temporary=$(mktemp "$state_root/.update-channel.XXXXXX")
trap 'rm -f -- "$temporary"' EXIT
printf '%s\n' "$channel" >"$temporary"
chown root:root "$temporary"
chmod 0644 "$temporary"
mv -f -- "$temporary" "$channel_file"
trap - EXIT

# Cached availability belongs to the previous channel. The unprivileged check
# repopulates it immediately after Control changes the selection.
rm -f -- "$check_root/latest-version" "$check_root/channel" \
    "$check_root/last-success" "$check_root/last-failure"
echo "Wasalight update channel: $channel"
