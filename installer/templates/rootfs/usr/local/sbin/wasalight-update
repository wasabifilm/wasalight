#!/usr/bin/env bash
# Copyright 2026 Michele Moser
# SPDX-License-Identifier: Apache-2.0
set -Eeuo pipefail
IFS=$'\n\t'

readonly checkout=/data/system/wasalight
readonly package_store=/data/system/packages
readonly log_root=/data/log/wasalight/updates
readonly legacy_log=/data/log/wasalight-update.log
readonly state_file=/data/system/update-state
readonly channel_file=/data/system/update-channel
readonly progress_file=/run/wasalight-update-progress-detail

. /usr/local/libexec/wasalight-release-manifest.sh
. /usr/local/libexec/wasalight-operation-lock.sh
repository=$(require_manifest_value /etc/wasalight/release-manifest.ini Wasalight Repository)
default_channel=$(require_manifest_value /etc/wasalight/release-manifest.ini Updates DefaultChannel)
stable_api=$(require_manifest_value /etc/wasalight/release-manifest.ini Updates StableAPI)
debug_ref=$(require_manifest_value /etc/wasalight/release-manifest.ini Updates DebugRef)
tag_prefix=$(require_manifest_value /etc/wasalight/release-manifest.ini Updates TagPrefix)
signer_file=$(require_manifest_value /etc/wasalight/release-manifest.ini Updates SignerFile)
magicq_package=$(require_manifest_value /etc/wasalight/release-manifest.ini MagicQ Package)
magicq_architecture=$(require_manifest_value /etc/wasalight/release-manifest.ini MagicQ Architecture)
. /usr/local/libexec/wasalight-update-lib.sh

protect=0
code_only=0
reboot_after=0
ssh_mode=preserve
allow_missing_magicq=0
with_companion=0
verbose=0
rollback=0
plan_only=0
repair=0
resume=0
channel_override=
explicit_state_change=0
plugins=()
snapshot=
snapshot_tool=/run/wasalight-update-snapshot
candidate_checkout=
previous_checkout="${checkout}.previous"
transaction_started=
transaction_status=
channel=
stable_tag=
checkout_activated=0
channel_persisted=0
previous_channel=
previous_channel_present=0
interrupted_checkout=
completed_commit=

usage() {
    cat <<'EOT'
Usage: sudo wasalight-update [options]

Scarica e verifica l'ultima versione di Wasalight, conserva il pacchetto
MagicQ e aggiorna la macchina in modalità MAINTENANCE.

Opzioni:
  --protect       Prepara SHOW / PROTECTED per il prossimo avvio.
  --code-only     Scarica e verifica il codice senza installarlo.
  --reboot        Riavvia automaticamente dopo un aggiornamento riuscito.
  --verbose       Mostra anche ogni comando eseguito; il log resta completo
                  anche senza questa opzione.
  --plan          Scarica e verifica il codice, quindi mostra cosa cambierebbe
                  senza scrivere su /data o modificare il sistema.
  --channel NOME  Seleziona stable (release GitHub immutabile e firmata) oppure
                  debug (ultimo commit del ramo main). La scelta riuscita resta
                  persistente. Predefinito: stable.
  --resume        Riprende in sicurezza una transazione interrotta usando lo
                  snapshot già creato e ripetendo le fasi idempotenti.
  --repair        Reinstalla la release anche quando versione e commit
                  coincidono; utile per riparare una configurazione alterata.
  --rollback      Ripristina l'ultimo snapshot della configurazione Wasalight
                  e termina senza scaricare o installare codice.
  --with-ssh      Mantiene SSH attivo automaticamente dopo il riavvio.
  --without-ssh   Mantiene SSH spento all'avvio; il pulsante resta disponibile.
  --with-companion
                  Installa Bitfocus Companion se non è ancora presente; le
                  installazioni esistenti vengono sempre conservate.
  --plugin ID     Abilita un plugin Wasalight. Ripetibile; ID disponibili:
                  companion, ssh, vnc.
  --allow-missing-magicq
                  Continua esplicitamente se MagicQ non è installato e non è
                  disponibile alcun .deb valido nel sistema o sulle USB.
  -h, -help, --help
                  Mostra tutte le opzioni.
EOT
}

while (($#)); do
    case $1 in
        --protect) protect=1; explicit_state_change=1 ;;
        --code-only) code_only=1 ;;
        --reboot) reboot_after=1 ;;
        --verbose) verbose=1 ;;
        --rollback) rollback=1 ;;
        --plan) plan_only=1 ;;
        --repair) repair=1 ;;
        --resume) resume=1 ;;
        --channel)
            shift
            (($#)) || { echo "--channel richiede stable o debug" >&2; exit 2; }
            channel_override=$1
            ;;
        --with-ssh) ssh_mode=enabled; explicit_state_change=1 ;;
        --without-ssh) ssh_mode=disabled; explicit_state_change=1 ;;
        --with-companion) with_companion=1; explicit_state_change=1; plugins+=(companion) ;;
        --plugin)
            shift
            (($#)) || { echo "--plugin richiede un ID" >&2; exit 2; }
            case $1 in
                companion) with_companion=1 ;;
                ssh|vnc) ;;
                *) echo "Plugin Wasalight sconosciuto: $1" >&2; exit 2 ;;
            esac
            explicit_state_change=1
            plugins+=("$1")
            ;;
        --allow-missing-magicq) allow_missing_magicq=1 ;;
        -h|-help|--help) usage; exit 0 ;;
        *) echo "Opzione sconosciuta: $1" >&2; usage >&2; exit 2 ;;
    esac
    shift
done

if ((code_only && (reboot_after || plan_only || resume))) || \
   ((rollback && (code_only || reboot_after || plan_only || repair || resume))) || \
   ((plan_only && (reboot_after || resume))) || ((resume && repair)); then
    echo "--rollback, --code-only, --plan e --reboot hanno combinazioni non valide." >&2
    exit 2
fi

[[ $EUID -eq 0 ]] || { echo "Esegui con: sudo wasalight-update" >&2; exit 1; }
wasalight_acquire_operation_lock "aggiornamento Wasalight"
rm -f /run/wasalight-update-reboot-required
[[ $(findmnt -n -o FSTYPE / 2>/dev/null) != overlay ]] || {
    echo "Serve la modalità MAINTENANCE. Esegui sudo wasalight-maintenance e riavvia." >&2
    exit 1
}
mountpoint -q /data || { echo "/data non è montata: aggiornamento interrotto." >&2; exit 1; }
if [[ -r $channel_file ]]; then
    previous_channel=$(<"$channel_file")
    previous_channel_present=1
fi
if [[ -n $channel_override ]]; then
    channel=$(normalize_update_channel "$channel_override") || exit $?
elif [[ -r $channel_file ]]; then
    channel=$(normalize_update_channel "$(<"$channel_file")") || exit $?
else
    channel=$(normalize_update_channel "$default_channel") || exit $?
fi
if ((rollback)); then
    [[ -x /usr/local/sbin/wasalight-update-snapshot ]] || {
        echo "Nessun gestore rollback installato." >&2; exit 1;
    }
    latest_snapshot=
    if [[ -r $state_file ]]; then
        transaction_status=$(update_state_value "$state_file" status 2>/dev/null || true)
        case $transaction_status in
            running|failed) latest_snapshot=$(update_state_value "$state_file" snapshot 2>/dev/null || true) ;;
        esac
    fi
    [[ -z $latest_snapshot || -r $latest_snapshot ]] || latest_snapshot=
    [[ -n $latest_snapshot ]] || latest_snapshot=$(/usr/local/sbin/wasalight-update-snapshot list | head -n 1)
    [[ -n $latest_snapshot ]] || { echo "Nessuno snapshot disponibile." >&2; exit 1; }
    echo "Ripristino dell'ultimo snapshot: $latest_snapshot"
    /usr/local/sbin/wasalight-update-snapshot restore "$latest_snapshot"
    [[ ! -r $state_file ]] || update_state_write "$state_file" rolled-back rollback \
        "$(update_state_value "$state_file" version 2>/dev/null || true)" \
        "$(update_state_value "$state_file" commit 2>/dev/null || true)" \
        "$latest_snapshot" "$(update_state_value "$state_file" started 2>/dev/null || true)" \
        "$(update_state_value "$state_file" channel 2>/dev/null || echo "$channel")" \
        "$(update_state_value "$state_file" candidate 2>/dev/null || true)"
    echo "Rollback completato. Riavviare la macchina."
    exit 0
fi
exec 3>&1
if ((plan_only)); then
    log_file=/dev/null
    current_log=/dev/null
    export GIT_OPTIONAL_LOCKS=0
else
    install -d -o root -g root -m 0755 /data/system
    install -d -o chamsys -g chamsys -m 0750 /data/log
    install -d -o root -g adm -m 0750 /data/log/wasalight "$log_root"
    install -d -o root -g root -m 0750 "$package_store"
    run_stamp=$(date +%Y%m%d-%H%M%S)
    log_file="$log_root/update-$run_stamp.log"
    current_log=$legacy_log
    touch "$log_file" "$current_log"
    chown root:adm "$log_file" "$current_log" 2>/dev/null || \
        chown root:root "$log_file" "$current_log"
    chmod 0640 "$log_file" "$current_log"
fi
# Individual run logs are intentionally self-contained. Keep the most recent
# twenty and remove files older than thirty days so /data cannot grow forever.
if ((!plan_only)); then
    find "$log_root" -maxdepth 1 -type f -name 'update-*.log' -mtime +30 -delete
    mapfile -t stale_run_logs < <(find "$log_root" -maxdepth 1 -type f \
        -name 'update-*.log' -printf '%T@\t%p\n' | sort -nr | tail -n +21 | cut -f2-)
    ((${#stale_run_logs[@]} == 0)) || rm -f -- "${stale_run_logs[@]}"
fi
# Keep a direct descriptor for the operator terminal. Long-running commands
# write their complete output only to the persistent logs while this descriptor
# receives the compact progress UI.
if ((!plan_only)); then
    exec > >(tee -a "$current_log" "$log_file") 2>&1
fi
((verbose)) && { export PS4='+ ${BASH_SOURCE##*/}:${LINENO}: '; set -x; }

phase="Preparazione"
if [[ -t 3 ]]; then
    brand=$'\033[1;38;2;118;189;34m'
    green=$'\033[1;32m'; amber=$'\033[1;33m'; red=$'\033[1;31m'
    white=$'\033[1;37m'; muted=$'\033[38;5;245m'; reset=$'\033[0m'
    clear_line=$'\033[2K'
else
    brand= green= amber= red= white= muted= reset= clear_line=
fi
step() { phase=$*; printf '\n%s▶ %s%s\n' "$brand" "$phase" "$reset"; }
banner() {
    printf '\n%s┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓%s\n' "$brand" "$reset"
    printf '%s┃%s  %sWASALIGHT UPDATE%s                                  %s┃%s\n' \
        "$brand" "$reset" "$white" "$reset" "$brand" "$reset"
    printf '%s┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛%s\n' "$brand" "$reset"
}

# Run a potentially slow command without flooding the touch-friendly terminal.
# Raw stdout/stderr are always retained in both update logs. The indicator is a
# separate child: the real command stays in the foreground, so its completion is
# observed directly instead of polling a PID that could remain as a zombie.
progress_indicator() {
    local label=$1 elapsed=0 frame=0 detail=
    local -a frames=('●··' '·●·' '··●' '·●·')
    while :; do
        if [[ -r $progress_file ]]; then
            detail=$(<"$progress_file")
            [[ -n $detail ]] && label=$detail
        fi
        printf '\r%s  %s%s  %-38s %02d:%02d%s' \
            "$clear_line" "$brand" "${frames[frame]}" "$label" \
            "$((elapsed / 60))" "$((elapsed % 60))" "$reset" >&3
        frame=$(((frame + 1) % ${#frames[@]}))
        sleep 1
        ((elapsed += 1))
    done
}

_run_with_progress() {
    local label=$1 destination=$2
    shift 2
    local indicator_pid rc raw_output started elapsed
    local -a command_status

    raw_output=$(mktemp /run/wasalight-update-progress.XXXXXX)
    rm -f -- "$progress_file"
    started=$SECONDS
    progress_indicator "$label" &
    indicator_pid=$!
    # Tee writes the hidden output to both persistent logs while the command is
    # still running. This preserves diagnostics even after a power interruption.
    set +e
    (trap - ERR; set +e; "$@") 2>&1 | \
        tee -a "$current_log" "$log_file" >"$raw_output"
    command_status=("${PIPESTATUS[@]}")
    set -e
    rc=${command_status[0]}
    ((rc != 0 || command_status[1] == 0)) || rc=${command_status[1]}
    kill "$indicator_pid" 2>/dev/null || true
    wait "$indicator_pid" 2>/dev/null || true
    elapsed=$((SECONDS - started))
    [[ -z $destination ]] || cp "$raw_output" "$destination"
    printf '\r%s' "$clear_line" >&3
    ((verbose)) && cat "$raw_output" >&3
    if ((rc == 0)); then
        printf '%s  ✓%s  %s completato (%02d:%02d)\n' \
            "$green" "$reset" "$label" "$((elapsed / 60))" "$((elapsed % 60))"
    else
        printf '%s  ✗%s  %s non riuscito\n' "$red" "$reset" "$label" >&3
        printf '%sUltime righe del log:%s\n' "$amber" "$reset" >&3
        tail -n 24 "$raw_output" >&3 || true
    fi
    rm -f -- "$raw_output"
    rm -f -- "$progress_file"
    return "$rc"
}

run_with_progress() {
    local label=$1
    shift
    local rc command
    printf -v command '%q ' "$@"
    if _run_with_progress "$label" "" "$@"; then
        return 0
    else
        rc=$?
        update_failed "$rc" "${BASH_LINENO[0]}" "${command% }"
    fi
}

run_with_progress_capture() {
    local destination=$1 label=$2
    shift 2
    _run_with_progress "$label" "$destination" "$@"
}
update_failed() {
    local rc=$1 line=$2 command=$3 failed_checkout
    trap - ERR
    printf '\n%sERRORE%s · aggiornamento interrotto nella fase: %s\n' \
        "$red" "$reset" "$phase" >&2
    printf 'Comando: %s\nLinea: %s · codice: %s\n' "$command" "$line" "$rc" >&2
    echo "La macchina non verrà riavviata." >&2
    if ((checkout_activated)) && [[ -d $previous_checkout/.git ]]; then
        echo "Ripristino del checkout precedente…" >&2
        failed_checkout="${checkout}.failed"
        rm -rf -- "$failed_checkout"
        mv "$checkout" "$failed_checkout"
        mv "$previous_checkout" "$checkout"
        rm -rf -- "$failed_checkout"
        checkout_activated=0
    elif ((checkout_activated)) && [[ ${existing_checkout:-0} == 0 ]]; then
        echo "Rimuovo il checkout attivato dalla transazione non riuscita…" >&2
        rm -rf -- "$checkout"
        checkout_activated=0
    fi
    if ((channel_persisted)); then
        if ((previous_channel_present)); then
            atomic_text_write "$channel_file" "$previous_channel
" root:root 0644 || true
        else
            rm -f -- "$channel_file"
        fi
        channel_persisted=0
    fi
    if [[ -n ${transaction_started:-} ]]; then
        update_state_write "$state_file" failed "$phase" \
            "${available_version:-}" "${downloaded_commit:-}" "${snapshot:-}" \
            "$transaction_started" "$channel" "${candidate_checkout:-}" || true
    fi
    if [[ -n ${snapshot:-} && -r ${snapshot_tool:-} ]]; then
        echo "Ripristino automatico della configurazione precedente…" >&2
        if bash "$snapshot_tool" restore "$snapshot"; then
            echo "Configurazione precedente ripristinata. Riavviare prima dell'uso." >&2
            transaction_status=rolled-back
            [[ -z ${transaction_started:-} ]] || update_state_write "$state_file" \
                rolled-back "$phase" "${available_version:-}" "${downloaded_commit:-}" \
                "$snapshot" "$transaction_started" "$channel" "${candidate_checkout:-}" || true
        else
            transaction_status=failed
            echo "ATTENZIONE: rollback automatico non riuscito; snapshot: $snapshot" >&2
        fi
    fi
    echo "Log completo: $log_file" >&2
    [[ $current_log == /dev/null ]] || echo "Log cumulativo: $current_log" >&2
    exit "$rc"
}
trap 'update_failed "$?" "$LINENO" "$BASH_COMMAND"' ERR

banner
echo "Avvio: $(date --iso-8601=seconds)"
echo "Log di questa esecuzione: $log_file"
installed_version=$(cat /etc/wasalight/version 2>/dev/null || echo non-installata)
echo "Versione installata: $installed_version"
installed_commit=$(cat /etc/wasalight/commit 2>/dev/null || echo unknown)
echo "Commit installato: ${installed_commit:0:12}"
echo "Canale aggiornamenti: $channel"
update_preflight

if [[ -r $state_file ]]; then
    transaction_status=$(update_state_value "$state_file" status 2>/dev/null || true)
    if [[ $transaction_status == running || $transaction_status == failed ]]; then
        interrupted_phase=$(update_state_value "$state_file" phase 2>/dev/null || echo sconosciuta)
        interrupted_snapshot=$(update_state_value "$state_file" snapshot 2>/dev/null || true)
        if ((plan_only)); then
            echo "ATTENZIONE: transazione precedente $transaction_status (fase: $interrupted_phase)."
        elif ((resume || repair)); then
            snapshot=$interrupted_snapshot
            echo "Ripresa della transazione precedente dalla fase: $interrupted_phase"
            [[ -z $snapshot || -r $snapshot ]] || {
                echo "Snapshot registrato ma non leggibile: $snapshot" >&2
                exit 1
            }
            if [[ -d $previous_checkout/.git && -d $checkout/.git ]]; then
                echo "Ripristino il checkout precedente lasciato da un'attivazione interrotta."
                interrupted_checkout="${checkout}.interrupted"
                rm -rf -- "$interrupted_checkout"
                mv "$checkout" "$interrupted_checkout"
                mv "$previous_checkout" "$checkout"
                rm -rf -- "$interrupted_checkout"
            fi
        else
            cat >&2 <<EOF
Esiste una transazione Wasalight non conclusa (stato: $transaction_status, fase: $interrupted_phase).
Scegli esplicitamente una delle operazioni:
  sudo wasalight-update --resume
  sudo wasalight-update --repair
  sudo wasalight-update --rollback
EOF
            exit 3
        fi
    elif ((resume)); then
        echo "Nessuna transazione interrotta da riprendere." >&2
        exit 2
    elif ((!plan_only)) && [[ $transaction_status == complete && -d $previous_checkout/.git && -d $checkout/.git ]]; then
        completed_commit=$(update_state_value "$state_file" commit 2>/dev/null || true)
        if [[ $completed_commit =~ ^[0-9a-f]{40}$ && \
              $(git -C "$checkout" rev-parse --verify HEAD 2>/dev/null || true) == "$completed_commit" ]]; then
            rm -rf -- "$previous_checkout"
        fi
    fi
elif ((resume)); then
    echo "Nessuna transazione interrotta da riprendere." >&2
    exit 2
fi

step "1/5 · Controllo dei pacchetti MagicQ"
if ((plan_only)); then
    echo "Simulazione: le USB vengono ispezionate solo durante un aggiornamento reale."
else
    find "$package_store" -maxdepth 1 -type f -name '.magicq-import.*' -delete
    while IFS= read -r usb_mount; do
        echo "Controllo USB montata: $usb_mount"
        while IFS= read -r -d '' usb_package; do
            import_magicq_package "$usb_package" 0
        done < <(find "$usb_mount" -maxdepth 1 -type f -name '*.deb' -print0 2>/dev/null)
        if [[ -d $usb_mount/packages ]]; then
            while IFS= read -r -d '' usb_package; do
                import_magicq_package "$usb_package" 0
            done < <(find "$usb_mount/packages" -maxdepth 1 -type f -name '*.deb' -print0 2>/dev/null)
        fi
        while IFS= read -r -d '' apfs_volume; do
            while IFS= read -r -d '' usb_package; do
                import_magicq_package "$usb_package" 0
            done < <(find "$apfs_volume" -maxdepth 1 -type f -iname '*.deb' -print0 2>/dev/null)
            if [[ -d $apfs_volume/packages ]]; then
                while IFS= read -r -d '' usb_package; do
                    import_magicq_package "$usb_package" 0
                done < <(find "$apfs_volume/packages" -maxdepth 1 -type f -iname '*.deb' -print0 2>/dev/null)
            fi
        done < <(find "$usb_mount" -mindepth 1 -maxdepth 1 -type d \
            -name 'fsapfs[0-9]*' -print0 2>/dev/null)
    done < <(findmnt -rn -o TARGET 2>/dev/null | awk '$0 ~ "^/stick/[^/]+$"')
fi

if ((!plan_only)) && [[ ! -e $checkout && -d $previous_checkout/.git ]]; then
    echo "Ripristino il checkout precedente dopo un aggiornamento interrotto."
    mv "$previous_checkout" "$checkout"
fi
if [[ -e $checkout && ! -d $checkout/.git ]]; then
    echo "Il percorso aggiornamenti esiste ma non è un repository Git: $checkout" >&2
    exit 1
fi

step "2/5 · Download dell'ultima versione"
existing_checkout=0
old_checkout_commit=
if [[ -d $checkout/.git ]]; then
    if [[ -n $(git -C "$checkout" status --porcelain) ]]; then
        echo "Il repository persistente contiene modifiche locali: aggiornamento interrotto." >&2
        exit 1
    fi
    existing_checkout=1
    old_checkout_commit=$(git -C "$checkout" rev-parse --verify HEAD)
fi

if ((plan_only)); then
    candidate_checkout=$(mktemp -d /tmp/wasalight-plan.XXXXXX)
else
    candidate_checkout="${checkout}.candidate"
    rm -rf -- "$candidate_checkout"
    install -d -o root -g root -m 0750 "$candidate_checkout"
fi
cleanup_candidate() {
    if ((plan_only)) || [[ -z ${transaction_started:-} || ${transaction_status:-} == complete || ${transaction_status:-} == rolled-back ]]; then
        [[ -z ${candidate_checkout:-} ]] || rm -rf -- "$candidate_checkout"
    fi
    if [[ ! -e $checkout && -d $previous_checkout/.git ]]; then
        mv "$previous_checkout" "$checkout"
    fi
}
trap cleanup_candidate EXIT
if [[ -d $checkout/.git ]]; then
    git clone --quiet --no-hardlinks --no-checkout "$checkout" "$candidate_checkout"
    git -C "$candidate_checkout" remote set-url origin "$repository"
else
    git -C "$candidate_checkout" init --quiet
    git -C "$candidate_checkout" remote add origin "$repository"
fi
if [[ $channel == stable ]]; then
    release_json=$(mktemp /tmp/wasalight-release.XXXXXX)
    stable_tag=$(discover_stable_release "$stable_api" "$release_json") || {
        rm -f -- "$release_json"
        echo "Impossibile trovare una release stable immutabile. Usa --channel debug solo per test." >&2
        exit 1
    }
    rm -f -- "$release_json"
    [[ $stable_tag == "$tag_prefix"* && ${stable_tag#"$tag_prefix"} =~ ^[0-9]{4}\.[0-9]{2}\.[0-9]{2}\.[0-9]+$ ]] || {
        echo "Tag release stable non valido: $stable_tag" >&2; exit 1;
    }
    run_with_progress "Download release $stable_tag" \
        git_retry -C "$candidate_checkout" fetch --quiet origin \
        "refs/tags/$stable_tag:refs/tags/$stable_tag"
    verify_stable_tag "$candidate_checkout" "$stable_tag" "$signer_file" || {
        echo "Firma della release stable non valida: $stable_tag" >&2
        exit 1
    }
    remote_commit=$(git -C "$candidate_checkout" rev-parse --verify "$stable_tag^{commit}")
else
    if ((existing_checkout)); then
        run_with_progress "Download canale debug" \
            git_retry -C "$candidate_checkout" fetch --quiet origin "$debug_ref"
    else
        run_with_progress "Download canale debug" \
            git_retry -C "$candidate_checkout" fetch --quiet --depth=1 origin "$debug_ref"
    fi
    remote_commit=$(git -C "$candidate_checkout" rev-parse --verify FETCH_HEAD)
fi
[[ $remote_commit =~ ^[0-9a-f]{40}$ ]] || {
    echo "Impossibile determinare il commit remoto del canale $channel." >&2; exit 1;
}
if ((existing_checkout)) && \
   ! git -C "$candidate_checkout" merge-base --is-ancestor \
        "$old_checkout_commit" "$remote_commit"; then
    echo "Il ramo remoto non è un avanzamento fast-forward del checkout verificato." >&2
    exit 1
fi
git -C "$candidate_checkout" checkout --quiet --detach "$remote_commit"
downloaded_commit=$(git -C "$candidate_checkout" rev-parse --verify HEAD)
[[ $downloaded_commit == "$remote_commit" ]] || {
    echo "Il checkout candidato non corrisponde al commit remoto: $remote_commit" >&2
    exit 1
}

step "3/5 · Verifica del progetto scaricato"
run_with_progress "Test del progetto" "$candidate_checkout/tests/verify-project.sh"
available_version=$(<"$candidate_checkout/VERSION")
[[ $available_version =~ ^[0-9]{4}\.[0-9]{2}\.[0-9]{2}\.[0-9]+$ ]] || {
    echo "VERSION scaricata non valida: $available_version" >&2
    exit 1
}
if [[ $channel == stable && $stable_tag != "$tag_prefix$available_version" ]]; then
    echo "Release incoerente: il tag $stable_tag contiene VERSION $available_version." >&2
    exit 1
fi
if [[ $installed_version =~ ^[0-9]{4}\.[0-9]{2}\.[0-9]{2}\.[0-9]+$ ]] && \
   [[ $(printf '%s\n%s\n' "$installed_version" "$available_version" | sort -V | tail -n1) == "$installed_version" ]] && \
   [[ $available_version != "$installed_version" ]]; then
    echo "Downgrade bloccato: installata $installed_version, disponibile $available_version." >&2
    exit 1
fi
if [[ $installed_version == "$available_version" && \
      $installed_commit =~ ^[0-9a-f]{40}$ && \
      $installed_commit != "$downloaded_commit" ]]; then
    echo "Release incoerente: la versione $available_version è associata a un commit differente." >&2
    echo "Pubblicare un nuovo numero VERSION prima di aggiornare." >&2
    exit 1
fi
echo "Versione disponibile: $available_version"
echo "Commit disponibile: ${downloaded_commit:0:12}"
echo "Codice candidato verificato."

installer_args=()
((protect)) || installer_args+=(--no-protection)
if [[ $ssh_mode == preserve ]]; then
    ssh_mode=disabled
    [[ -r /data/system/service-flags/ssh-autostart ]] && \
        [[ $(</data/system/service-flags/ssh-autostart) == enabled ]] && ssh_mode=enabled
fi
if [[ $ssh_mode == enabled ]]; then
    installer_args+=(--with-ssh)
else
    installer_args+=(--without-ssh)
fi
((with_companion)) && installer_args+=(--with-companion)
# Preserve the plugin selection recorded on /data. Disabled plugins remain
# installed but are not silently re-enabled by an ordinary Wasalight update.
for plugin_state in /data/system/plugins-state/*; do
    [[ -f $plugin_state ]] || continue
    [[ $(<"$plugin_state") == enabled ]] || continue
    plugin_id=${plugin_state##*/}
    case $plugin_id in
        companion|ssh|vnc) plugins+=("$plugin_id") ;;
    esac
done
for plugin in "${plugins[@]-}"; do
    [[ -n $plugin ]] && installer_args+=(--plugin "$plugin")
done

select_newest_magicq_package
installed_magicq_version=
installed_magicq_record=$(dpkg-query -W -f='${db:Status-Abbrev}\t${Version}' magicq \
    2>/dev/null || true)
[[ $installed_magicq_record == ii*$'\t'* ]] && \
    installed_magicq_version=${installed_magicq_record#*$'\t'}
magicq_change=0
if [[ -n $selected_package ]]; then
    if [[ -z $installed_magicq_version ]] || \
       dpkg --compare-versions "$selected_package_version" gt "$installed_magicq_version" || \
       ((repair)); then
        echo "Pacchetto MagicQ da installare: $selected_package (versione $selected_package_version)"
        installer_args+=("$selected_package")
        magicq_change=1
    elif dpkg --compare-versions "$selected_package_version" eq "$installed_magicq_version"; then
        echo "MagicQ $installed_magicq_version è già installato; reinstallazione evitata."
    else
        echo "MagicQ installato $installed_magicq_version è più recente del pacchetto conservato $selected_package_version; downgrade evitato."
    fi
elif [[ -n $installed_magicq_version ]]; then
    echo "MagicQ $installed_magicq_version è già installato; nessun pacchetto locale necessario."
elif ((allow_missing_magicq)); then
    echo "ATTENZIONE: assenza di MagicQ ignorata esplicitamente." >&2
    installer_args+=(--allow-missing-magicq)
else
    echo "ERRORE: MagicQ non è installato e nessun pacchetto valido è stato trovato." >&2
    echo "Per continuare intenzionalmente senza MagicQ, ripeti con:" >&2
    echo "  sudo wasalight-update --allow-missing-magicq" >&2
    exit 2
fi

same_release=0
if [[ $installed_version == "$available_version" && \
      $installed_commit == "$downloaded_commit" ]]; then
    same_release=1
fi

printf '\nPIANO AGGIORNAMENTO\n'
printf '  Wasalight: %s (%s) → %s (%s)\n' \
    "$installed_version" "${installed_commit:0:12}" \
    "$available_version" "${downloaded_commit:0:12}"
if ((magicq_change)); then
    printf '  MagicQ:    %s → %s\n' "${installed_magicq_version:-non installato}" "$selected_package_version"
else
    printf '  MagicQ:    invariato (%s)\n' "${installed_magicq_version:-non installato}"
fi
printf '  Snapshot:  %s\n' "$([[ $plan_only == 1 ]] && echo 'non creata (--plan)' || echo 'creata prima delle modifiche')"
printf '  Modalità:  %s\n' "$([[ $protect == 1 ]] && echo 'SHOW al prossimo avvio' || echo 'MAINTENANCE al prossimo avvio')"

if ((plan_only)); then
    echo "Piano completato: nessuna configurazione di sistema è stata modificata."
    exit 0
fi
if ((same_release && !explicit_state_change && !magicq_change && !repair && !resume)); then
    atomic_text_write "$channel_file" "$channel
" root:root 0644
    printf '%sOK%s · sistema già aggiornato; snapshot, APT e installer non necessari.\n' \
        "$green" "$reset"
    exit 0
fi

transaction_started=$(update_state_value "$state_file" started 2>/dev/null || true)
[[ -n $transaction_started ]] || transaction_started=$(date --iso-8601=seconds)
transaction_status=running
update_state_write "$state_file" running verified "$available_version" \
    "$downloaded_commit" "$snapshot" "$transaction_started" "$channel" "$candidate_checkout"

persist_channel() {
    atomic_text_write "$channel_file" "$channel
" root:root 0644
    channel_persisted=1
}

activate_candidate() {
    update_state_write "$state_file" running activating "$available_version" \
        "$downloaded_commit" "$snapshot" "$transaction_started" "$channel" "$candidate_checkout"
    rm -rf -- "$previous_checkout"
    if [[ -d $checkout/.git ]]; then
        mv "$checkout" "$previous_checkout"
    fi
    mv "$candidate_checkout" "$checkout"
    candidate_checkout=
    checkout_activated=1
    echo "Checkout attivo aggiornato atomicamente in $checkout"
}

if ((code_only)); then
    persist_channel
    activate_candidate
    update_state_write "$state_file" complete complete "$available_version" \
        "$downloaded_commit" "" "$transaction_started" "$channel" "$checkout"
    transaction_status=complete
    rm -rf -- "$previous_checkout"
    checkout_activated=0
    echo
    printf '%sOK%s · codice aggiornato e verificato; configurazione non reinstallata.\n' \
        "$green" "$reset"
    exit 0
fi

# The helper is taken from the checkout just verified, so even the first
# upgrade to this release can create and automatically restore a snapshot.
install -o root -g root -m 0755 "$candidate_checkout/libexec/wasalight-update-snapshot" \
    "$snapshot_tool"
bash -n "$snapshot_tool"
if [[ -n $snapshot ]]; then
    echo "Riutilizzo snapshot della transazione: $snapshot"
else
    update_state_write "$state_file" running snapshot "$available_version" \
        "$downloaded_commit" "" "$transaction_started" "$channel" "$candidate_checkout"
    snapshot_output=$(mktemp /run/wasalight-update-snapshot-output.XXXXXX)
    if run_with_progress_capture "$snapshot_output" "Creazione snapshot" \
            bash "$snapshot_tool" create; then
        snapshot=$(tail -n 1 "$snapshot_output")
        rm -f -- "$snapshot_output"
    else
        snapshot_rc=$?
        rm -f -- "$snapshot_output"
        update_failed "$snapshot_rc" "$LINENO" 'bash "$snapshot_tool" create'
    fi
    update_state_write "$state_file" running snapshot-ready "$available_version" \
        "$downloaded_commit" "$snapshot" "$transaction_started" "$channel" "$candidate_checkout"
fi
echo "Snapshot pre-aggiornamento: $snapshot"

step "4/5 · Installazione della configurazione Wasalight"
update_state_write "$state_file" running installing "$available_version" \
    "$downloaded_commit" "$snapshot" "$transaction_started" "$channel" "$candidate_checkout"
run_with_progress "Installazione Wasalight" \
    env NEEDRESTART_SUSPEND=1 WASALIGHT_UPDATE_TRANSACTION=1 \
    WASALIGHT_PROGRESS_FILE="$progress_file" \
    "$candidate_checkout/install.sh" "${installer_args[@]}"

step "5/5 · Verifica finale e attivazione"
update_state_write "$state_file" running health-check "$available_version" \
    "$downloaded_commit" "$snapshot" "$transaction_started" "$channel" "$candidate_checkout"
[[ $(cat /etc/wasalight/version 2>/dev/null || true) == "$available_version" ]] || {
    echo "La versione installata non corrisponde al candidato verificato." >&2
    false
}
[[ $(cat /etc/wasalight/commit 2>/dev/null || true) == "$downloaded_commit" ]] || {
    echo "Il commit installato non corrisponde al candidato verificato." >&2
    false
}
bash -n /usr/local/sbin/wasalight-update
mountpoint -q /data

persist_channel
activate_candidate
update_state_write "$state_file" complete complete "$available_version" \
    "$downloaded_commit" "$snapshot" "$transaction_started" "$channel" "$checkout"
transaction_status=complete
rm -rf -- "$previous_checkout"
checkout_activated=0
touch /run/wasalight-update-reboot-required

trap - ERR
printf '\n%s┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓%s\n' "$green" "$reset"
printf '%s┃%s  %sAGGIORNAMENTO COMPLETATO%s                         %s┃%s\n' \
    "$green" "$reset" "$white" "$reset" "$green" "$reset"
printf '%s┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛%s\n' "$green" "$reset"
echo "Fine: $(date --iso-8601=seconds)"
printf '%sOK%s · tutte le fasi sono terminate correttamente.\n' "$green" "$reset"
if ((protect)); then
    echo "Prossimo avvio: SHOW / PROTECTED"
else
    echo "Prossimo avvio: MAINTENANCE"
fi

if ((reboot_after)); then
    echo "Riavvio in corso…"
    sync
    systemctl reboot
else
    echo "Riavvia per rendere effettive tutte le modifiche."
fi
