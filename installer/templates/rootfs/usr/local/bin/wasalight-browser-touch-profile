#!/usr/bin/env bash
# Copyright 2026 Michele Moser
# SPDX-License-Identifier: Apache-2.0
# Apply touch sizing to GNOME Web's GTK chrome without altering web content.

set -Eeuo pipefail
[[ $(id -un) == chamsys ]] || exit 1
[[ -n ${XDG_CONFIG_HOME:-} ]] || exit 1

gtk_config="$XDG_CONFIG_HOME/gtk-4.0"
css_file="$gtk_config/gtk.css"
begin_marker='/* WASALIGHT TOUCH BEGIN */'
end_marker='/* WASALIGHT TOUCH END */'
install -d -m 0700 "$gtk_config"

temporary=$(mktemp "${css_file}.tmp.XXXXXX")
if [[ -r $css_file ]]; then
    awk -v begin="$begin_marker" -v end="$end_marker" '
        $0 == begin { managed=1; next }
        $0 == end { managed=0; next }
        !managed { print }
    ' "$css_file" >"$temporary"
fi

cat >>"$temporary" <<'EOF'
/* WASALIGHT TOUCH BEGIN */
/* GNOME Web application chrome only; WebKit page CSS is not affected. */
@define-color wasalight_background #1b1f20;
@define-color wasalight_panel #282d30;
@define-color wasalight_panel_alt #353b3e;
@define-color wasalight_text #f1f3f3;
@define-color wasalight_separator #4a5154;
@define-color wasalight_technical #0088bd;
@define-color wasalight_brand #76bd22;
/* Libadwaita 1.5 consumes these semantic names after loading application CSS. */
@define-color window_bg_color #1b1f20;
@define-color window_fg_color #f1f3f3;
@define-color view_bg_color #222729;
@define-color view_fg_color #f1f3f3;
@define-color headerbar_bg_color #1b1f20;
@define-color headerbar_fg_color #f1f3f3;
@define-color headerbar_border_color #4a5154;
@define-color popover_bg_color #282d30;
@define-color popover_fg_color #f1f3f3;
@define-color card_bg_color #282d30;
@define-color accent_color #8dcc3e;
@define-color accent_bg_color #76bd22;
@define-color accent_fg_color #10130d;

window,
headerbar,
.toolbar {
    background-color: @wasalight_background;
    color: @wasalight_text;
}

headerbar {
    min-height: 56px;
    border-bottom: 1px solid @wasalight_separator;
}

headerbar button,
.toolbar button,
popover button {
    min-width: 44px;
    min-height: 44px;
    padding: 6px;
    background-color: @wasalight_panel_alt;
    color: @wasalight_text;
    border-color: @wasalight_separator;
}

headerbar entry {
    min-height: 44px;
    font-size: 16px;
    background-color: @wasalight_panel;
    color: @wasalight_text;
}

popover contents {
    font-size: 16px;
    background-color: @wasalight_panel;
    color: @wasalight_text;
}

popover row {
    min-height: 44px;
    padding: 5px 10px;
    color: @wasalight_text;
}

popover row:hover,
popover row:selected {
    background-color: @wasalight_technical;
    color: @wasalight_text;
}

tabbar tab {
    min-height: 44px;
    padding: 3px 6px;
}

selection {
    background-color: @wasalight_brand;
    color: @wasalight_background;
}
/* WASALIGHT TOUCH END */
EOF

chmod 0600 "$temporary"
mv -f "$temporary" "$css_file"
