set -u

readonly green='#3fb950'
readonly yellow='#d29922'
readonly red='#f85149'
readonly blue='#58a6ff'

status_line() {
    printf '${font Sans:bold:size=11}${color %s}%s${goto 150}${font Sans:size=11}${color white}%s${font}\n' \
        "$1" "$2" "$3"
}

report=$(/usr/local/bin/wasalight-status 2>/dev/null || true)
field() {
    awk -F: -v key="$1" '$1 == key {sub(/^[^:]*:[[:space:]]*/, ""); print; exit}' \
        <<<"$report"
}

version=$(field WASALIGHT)
channel=$(field CHANNEL)
update=$(field UPDATE)
mode=$(field MODE)
data=$(field DATA)
magicq=$(field MAGICQ)
network=$(field NETWORK)
ip=$(field IP)
touch=$(field TOUCH)
companion=$(field COMPANION)
usb=$(field USB)
vnc=$(field VNC)
ssh=$(field SSH)
health=$(field HEALTH)

status_line "$blue" 'VERSION' "${version:-UNKNOWN}"
status_line "$blue" 'CHANNEL' "${channel^^}"
case ${update^^} in
    *RECOVERY*) status_line "$red" 'UPDATE' "$update" ;;
    AVAILABLE*) status_line "$yellow" 'UPDATE' "$update" ;;
    'UP TO DATE') status_line "$green" 'UPDATE' 'UP TO DATE' ;;
    *) status_line "$yellow" 'UPDATE' "${update^^}" ;;
esac

if [[ $mode == PROTECTED ]]; then
    status_line "$green" 'CURRENT' 'PROTECTED'
else
    status_line "$yellow" 'CURRENT' "${mode:-UNKNOWN}"
fi
if grep -Eq '^overlayroot="tmpfs:' /etc/overlayroot.local.conf 2>/dev/null; then
    status_line "$green" 'NEXT BOOT' 'PROTECTED'
elif grep -Fqx 'overlayroot="disabled"' /etc/overlayroot.local.conf 2>/dev/null; then
    status_line "$yellow" 'NEXT BOOT' 'MAINTENANCE'
else
    status_line "$red" 'NEXT BOOT' 'UNKNOWN'
fi

case ${magicq^^} in
    RUNNING*) status_line "$green" 'MAGICQ' "$magicq" ;;
    READY*) status_line "$yellow" 'MAGICQ' "$magicq" ;;
    *) status_line "$red" 'MAGICQ' "$magicq" ;;
esac
[[ $companion == 'not installed' ]] || status_line "$blue" 'COMPANION' "$companion"

if [[ $data == 'NOT MOUNTED' ]]; then
    status_line "$red" 'DATA' "$data"
else
    data_free=$(df -h --output=avail /data 2>/dev/null | tail -n 1 | xargs)
    status_line "$green" 'DATA' "MOUNTED · ${data_free:-?} free"
fi
if [[ $network == *unmanaged* ]]; then
    status_line "$red" 'NETWORK' "$network"
elif [[ -n $ip && $ip != unavailable ]]; then
    status_line "$green" 'NETWORK' "$ip"
else
    status_line "$yellow" 'NETWORK' 'DISCONNECTED'
fi
if [[ $touch == *ready* ]]; then
    status_line "$green" 'TOUCH' 'READY'
else
    status_line "$yellow" 'TOUCH' "${touch:0:32}"
fi

if [[ $usb == empty ]]; then
    status_line "$yellow" 'USB' 'EMPTY'
else
    usb_count=$(grep -o '/stick[0-9]*' <<<"$usb" | sort -u | awk 'END {print NR+0}')
    status_line "$green" 'USB' "$usb_count MOUNTED"
fi
if [[ -r /data/system/magicq-updates/available ]]; then
    IFS=$'\t' read -r usb_magicq_version _ \
        </data/system/magicq-updates/available || true
    [[ -z ${usb_magicq_version:-} ]] || \
        status_line "$yellow" 'MAGICQ USB' "READY · $usb_magicq_version"
fi

[[ $vnc == running* ]] && vnc_colour=$blue || vnc_colour=$yellow
[[ $ssh == running* ]] && ssh_colour=$blue || ssh_colour=$yellow
status_line "$vnc_colour" 'VNC' "$vnc"
status_line "$ssh_colour" 'SSH' "$ssh"
case ${health^^} in
    OK) status_line "$green" 'HEALTH' 'OK' ;;
    WARNING*|'CHECK FAILED'*) status_line "$red" 'HEALTH' "$health" ;;
esac
if aplay -l 2>/dev/null | grep -q '^card '; then
    status_line "$green" 'AUDIO' 'READY'
else
    status_line "$red" 'AUDIO' 'NO DEVICE'
fi
