"""Touch-friendly date, time, timezone and NTP control for Wasalight."""

import datetime
import gettext
import os
import subprocess

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gdk, GLib, Gtk


BACKEND = "/usr/local/sbin/wasalight-time-control"
_ = gettext.translation(
    "wasalight-system",
    localedir=os.environ.get("WASALIGHT_LOCALE_DIR", "/usr/local/share/locale"),
    fallback=True,
).gettext


def command_output(command, timeout=15):
    result = subprocess.run(
        command, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
        timeout=timeout, check=False)
    return result.returncode, (result.stdout or "").strip()


class DateTimeWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title=_("Date and time · Wasalight"))
        self.set_default_size(860, 640)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_keep_above(True)
        self.connect("destroy", Gtk.main_quit)
        self._install_style()

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        root.set_border_width(22)
        self.add(root)

        title = Gtk.Label()
        title.set_xalign(0)
        title.set_markup(_("<span size='22000' weight='bold' foreground='#76bd22'>Date and time</span>"))
        root.pack_start(title, False, False, 0)

        self.status = Gtk.Label()
        self.status.set_xalign(0)
        self.status.set_selectable(True)
        self.status.get_style_context().add_class("status")
        root.pack_start(self.status, False, False, 0)

        sync_box = self._section(_("Automatic synchronization"))
        sync_text = Gtk.Label(label=(
            _("Immediately corrects the clock through Chrony and re-enables "
              "automatic synchronization.")))
        sync_text.set_xalign(0)
        sync_text.set_line_wrap(True)
        sync_box.pack_start(sync_text, True, True, 0)
        sync_button = Gtk.Button(label=_("Synchronize now"))
        sync_button.connect("clicked", lambda _button: self.run_privileged(["sync"]))
        sync_box.pack_start(sync_button, False, False, 0)
        root.pack_start(sync_box, False, False, 0)

        timezone_box = self._section(_("Time zone"))
        self.timezone = Gtk.ComboBoxText()
        rc, zones = command_output(["timedatectl", "list-timezones"])
        if rc == 0:
            for zone in zones.splitlines():
                self.timezone.append(zone, zone)
        current_zone = self.current_timezone()
        self.timezone.set_active_id(current_zone)
        self.timezone.set_hexpand(True)
        timezone_box.pack_start(self.timezone, True, True, 0)
        timezone_button = Gtk.Button(label=_("Apply time zone"))
        timezone_button.connect("clicked", self.apply_timezone)
        timezone_box.pack_start(timezone_button, False, False, 0)
        root.pack_start(timezone_box, False, False, 0)

        manual_box = self._section(_("Manual setting"))
        now = datetime.datetime.now()
        self.date = Gtk.Entry()
        self.date.set_placeholder_text("YYYY-MM-DD")
        self.date.set_text(now.strftime("%Y-%m-%d"))
        self.date.set_width_chars(12)
        self.time = Gtk.Entry()
        self.time.set_placeholder_text("HH:MM:SS")
        self.time.set_text(now.strftime("%H:%M:%S"))
        self.time.set_width_chars(10)
        manual_box.pack_start(self.date, False, False, 0)
        manual_box.pack_start(self.time, False, False, 0)
        manual_button = Gtk.Button(label=_("Set manually"))
        manual_button.connect("clicked", self.apply_manual)
        manual_box.pack_start(manual_button, False, False, 0)
        root.pack_start(manual_box, False, False, 0)

        note = Gtk.Label(label=(
            _("Manual setting disables Chrony. Use “Synchronize now” to "
              "return to automatic mode.")))
        note.set_xalign(0)
        note.set_line_wrap(True)
        note.get_style_context().add_class("note")
        root.pack_start(note, False, False, 0)

        close = Gtk.Button(label=_("Close"))
        close.connect("clicked", lambda _button: self.close())
        close.set_halign(Gtk.Align.END)
        root.pack_end(close, False, False, 0)
        self.refresh()

    @staticmethod
    def _section(label):
        frame = Gtk.Frame(label=label)
        row = Gtk.Box(spacing=12)
        row.set_border_width(14)
        frame.add(row)
        return row

    def _install_style(self):
        css = Gtk.CssProvider()
        css.load_from_data(b"""
            window { background: #080b10; color: #f0f3f6; }
            frame { background: #161b22; border-color: #30363d; }
            frame > label { color: #9bd95a; font-weight: bold; }
            button { min-height: 48px; min-width: 160px; font-size: 15px; }
            entry, combobox { min-height: 44px; font-size: 15px; }
            .status { background: #161b22; padding: 14px; font-family: monospace; }
            .note { color: #b7bec7; }
        """)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), css,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    @staticmethod
    def current_timezone():
        rc, zone = command_output(
            ["timedatectl", "show", "--property=Timezone", "--value"])
        return zone if rc == 0 and zone else "Etc/UTC"

    def refresh(self):
        _rc, local = command_output(["date", "+%Y-%m-%d %H:%M:%S %Z"])
        _rc, utc = command_output(["date", "-u", "+%Y-%m-%d %H:%M:%S UTC"])
        _rc, rtc = command_output(["timedatectl", "show", "--property=RTCTimeUSec", "--value"])
        _rc, ntp = command_output(["systemctl", "is-active", "chrony.service"])
        _rc, tracking = command_output(["chronyc", "tracking"])
        offset = _("unavailable")
        for line in tracking.splitlines():
            if line.startswith("System time"):
                offset = line.split(":", 1)[-1].strip()
                break
        self.status.set_text(
            _("Local time:  {local}\nUTC time:    {utc}\nRTC:         {rtc}\n"
              "Time zone:   {zone}\nChrony:      {ntp}\nOffset:      {offset}").format(
                  local=local, utc=utc, rtc=rtc, zone=self.current_timezone(),
                  ntp=ntp, offset=offset))
        self.timezone.set_active_id(self.current_timezone())

    def dialog(self, message_type, title, text, buttons=Gtk.ButtonsType.OK):
        dialog = Gtk.MessageDialog(
            transient_for=self, modal=True, destroy_with_parent=True,
            message_type=message_type, buttons=buttons, text=title)
        dialog.format_secondary_text(text)
        dialog.set_position(Gtk.WindowPosition.CENTER_ON_PARENT)
        dialog.set_keep_above(True)
        response = dialog.run()
        dialog.destroy()
        return response

    def run_privileged(self, arguments):
        try:
            rc, output = command_output(["pkexec", BACKEND, *arguments], timeout=45)
        except subprocess.TimeoutExpired:
            self.dialog(Gtk.MessageType.ERROR, _("Operation timed out"),
                        _("Clock adjustment did not respond within 45 seconds."))
            return
        if rc:
            self.dialog(Gtk.MessageType.ERROR, _("Operation failed"),
                        output or _("Authentication cancelled or command failed."))
            return
        self.refresh()
        self.dialog(Gtk.MessageType.INFO, _("Date and time updated"),
                    output or _("Operation completed successfully."))

    def apply_timezone(self, _button):
        zone = self.timezone.get_active_id()
        if not zone:
            self.dialog(Gtk.MessageType.WARNING, _("Select a time zone"),
                        _("Choose a time zone from the list."))
            return
        self.run_privileged(["timezone", zone])

    def apply_manual(self, _button):
        value = f"{self.date.get_text().strip()} {self.time.get_text().strip()}"
        response = self.dialog(
            Gtk.MessageType.WARNING, _("Disable automatic time?"),
            _("Set {value} manually?\n\nChrony will be disabled.").format(value=value),
            Gtk.ButtonsType.OK_CANCEL)
        if response == Gtk.ResponseType.OK:
            self.run_privileged(["manual", value])


if __name__ == "__main__":
    DateTimeWindow().show_all()
    Gtk.main()
