#!/usr/bin/env bash
# Copyright 2026 Michele Moser
# SPDX-License-Identifier: Apache-2.0
set -Eeuo pipefail
. /usr/local/libexec/wasalight-i18n
[[ $(id -un) == chamsys ]] || {
    echo "Run the Companion browser as the chamsys desktop user." >&2
    exit 1
}
command -v falkon >/dev/null 2>&1 || {
    /usr/local/bin/wasalight-dialog --error --title="Companion Web UI" \
        --text="$( _ "Falkon is not installed. Run Wasalight update again." )" 2>/dev/null
    exit 1
}
[[ -d /opt/companion ]] || {
    /usr/local/bin/wasalight-dialog --error --title="Companion Web UI" \
        --text="$( _ "Bitfocus Companion is not installed." )" 2>/dev/null
    exit 1
}

if ! systemctl is-active --quiet companion.service; then
    /usr/local/bin/wasalight-dialog --question \
        --icon=/usr/local/share/icons/wasalight/companion.svg --width=520 --title="Companion Web UI" \
        --text="$( _ "Bitfocus Companion is stopped. Start it for this session?" )" \
        2>/dev/null || exit 0
    sudo -n /usr/local/sbin/wasalight-companion-control start || {
        /usr/local/bin/wasalight-dialog --error --title="Companion Web UI" \
            --text="$( _ "Unable to start Bitfocus Companion." )" 2>/dev/null
        exit 1
    }
fi

url=http://127.0.0.1:8000
ready=0
for _ in {1..30}; do
    if curl -sS --output /dev/null --connect-timeout 1 "$url" 2>/dev/null; then
        ready=1
        break
    fi
    sleep 0.3
done
((ready)) || {
    /usr/local/bin/wasalight-dialog --error --width=560 --title="Companion Web UI" \
        --text="$(printf "$(_ 'Companion is running but its web interface did not respond on %s.')" "$url")" \
        2>/dev/null
    exit 1
}

export XDG_CONFIG_HOME=/data/companion/browser/config
export XDG_DATA_HOME=/data/companion/browser/data
runtime_base=${XDG_RUNTIME_DIR:-/tmp}
export XDG_CACHE_HOME="$runtime_base/wasalight-companion-browser-cache"
install -d -m 0700 "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" "$XDG_CACHE_HOME"
/usr/local/bin/wasalight-falkon-profile

# Give the Companion web app its own X11 identity. Tint2 can then resolve the
# matching XDG desktop entry and show the Companion icon instead of Falkon's.
falkon --wmclass=WasalightCompanion --profile wasalight-companion "$url" &
browser_pid=$!
# Maximise without EWMH fullscreen so Tint2 remains reachable on touchscreens.
for _ in {1..30}; do
    # Falkon can hand the new window to an existing process, so WM_CLASS is
    # authoritative; PID remains a fallback for older Falkon builds.
    window_id=$(wmctrl -lx 2>/dev/null | \
        awk 'tolower($3) ~ /wasalightcompanion/ { print $1; exit }')
    [[ -n $window_id ]] || \
        window_id=$(wmctrl -lp 2>/dev/null | \
            awk -v pid="$browser_pid" '$3 == pid { print $1; exit }')
    if [[ -n $window_id ]]; then
        companion_icon=/usr/local/share/icons/wasalight/companion-official.png
        [[ -s $companion_icon ]] || \
            companion_icon=/usr/local/share/icons/wasalight/companion.svg
        wmctrl -ir "$window_id" -b add,maximized_vert,maximized_horz || true
        # Falkon publishes its own icon shortly after mapping. Reapply the
        # Companion icon briefly so the final EWMH value is the intended one.
        for _ in {1..4}; do
            /usr/local/bin/wasalight-x11-window-icon \
                "$window_id" "$companion_icon" || true
            sleep 0.4
        done
        break
    fi
    sleep 0.2
done
wait "$browser_pid"
