#!/usr/bin/env bash
# Copyright 2026 Michele Moser
# SPDX-License-Identifier: Apache-2.0
set -Eeuo pipefail
. /usr/local/libexec/wasalight-i18n

title='Wasalight · MagicQ'
if [[ $(findmnt -n -o FSTYPE / 2>/dev/null) == overlay ]]; then
    /usr/local/bin/wasalight-dialog --error \
        --icon=wasalight-magicq-install \
        --width=580 --title="$title" \
        --text="$( _ '<big><b>MAINTENANCE mode required.</b></big>\n\nSwitch to MAINTENANCE and reboot, then try the MagicQ installation again.' )"
    exit 1
fi

if ! /usr/local/bin/wasalight-dialog --question \
    --icon=wasalight-magicq-install \
    --width=620 --title="$title" \
    --text="$( _ '<big><b>Install or update MagicQ?</b></big>\n\nInsert a USB drive containing the MagicQ package in its root or packages folder. This works without Internet and does not update Wasalight.' )" \
    --ok-label="$( _ "Find and install" )" --cancel-label="$( _ "Cancel" )"; then
    exit 0
fi

log_file=$(mktemp /tmp/wasalight-magicq-install.XXXXXX)
trap 'rm -f -- "$log_file"' EXIT
set +e
pkexec /usr/local/sbin/wasalight-magicq-install >"$log_file" 2>&1 &
install_pid=$!
(
    while kill -0 "$install_pid" 2>/dev/null; do
        printf '# %s\n' "$( _ "Searching for and verifying the MagicQ package…" )"
        sleep 1
    done
) | /usr/local/bin/wasalight-dialog --progress --pulsate --auto-close --no-cancel \
    --width=560 --title="$title" 2>/dev/null
wait "$install_pid"
rc=$?
set -e

details=$(tail -n 18 "$log_file")
if ((rc != 0)); then
    /usr/local/bin/wasalight-dialog --error \
        --icon=wasalight-magicq-install \
        --width=680 --title="$title" \
        --text="$(printf "$(_ '<big><b>MagicQ installation failed.</b></big>\n\n%s')" "$details")"
    exit "$rc"
fi

/usr/local/bin/wasalight-dialog --info \
    --icon=wasalight-magicq-install --width=620 --title="$title" \
    --text="$(printf "$(_ '<big><b>MagicQ is ready.</b></big>\n\n%s')" "$details")"
