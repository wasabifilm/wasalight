#!/usr/bin/env bash
# Copyright 2026 Michele Moser
# SPDX-License-Identifier: Apache-2.0
set -Eeuo pipefail

readonly runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
readonly snapshot="$runtime_dir/wasalight-status.snapshot"
readonly lock_file="$runtime_dir/wasalight-status.lock"
readonly max_age=${WASALIGHT_STATUS_MAX_AGE:-8}
refresh=0
[[ ${1:-} != --refresh ]] || refresh=1
install -d -m 0700 "$runtime_dir"

fresh_snapshot() {
    [[ -s $snapshot ]] || return 1
    local modified now
    modified=$(stat -c %Y "$snapshot" 2>/dev/null || echo 0)
    now=$(date +%s)
    ((now - modified <= max_age))
}

if ((refresh == 0)) && fresh_snapshot; then
    cat "$snapshot"
    exit 0
fi

exec 9>"$lock_file"
flock 9
if ((refresh == 0)) && fresh_snapshot; then
    cat "$snapshot"
    exit 0
fi

temporary="${snapshot}.tmp.$$"
if /usr/local/libexec/wasalight-state-collect >"$temporary"; then
    chmod 0600 "$temporary"
    mv -f "$temporary" "$snapshot"
else
    rc=$?
    rm -f -- "$temporary"
    [[ ! -s $snapshot ]] || cat "$snapshot"
    exit "$rc"
fi
cat "$snapshot"
