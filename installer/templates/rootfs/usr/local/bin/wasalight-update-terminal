#!/usr/bin/env bash
# Copyright 2026 Michele Moser
# SPDX-License-Identifier: Apache-2.0
set -Eeuo pipefail
. "${WASALIGHT_I18N_HELPER:-/usr/local/libexec/wasalight-i18n}"
while (($#)); do
    case $1 in
        --plugin)
            (($# >= 2)) || { _ "--plugin requires an ID" >&2; printf '\n' >&2; exit 2; }
            case $2 in
                companion|ssh|vnc) export WASALIGHT_UPDATE_PLUGIN=$2 ;;
                *) printf '%s: %s\n' "$( _ "Unknown plugin" )" "$2" >&2; exit 2 ;;
            esac
            shift 2
            ;;
        --channel)
            (($# >= 2)) || { _ "--channel requires stable or debug" >&2; printf '\n' >&2; exit 2; }
            case $2 in
                stable|debug) export WASALIGHT_UPDATE_CHANNEL=$2 ;;
                *) printf '%s: %s\n' "$( _ "Unknown update channel" )" "$2" >&2; exit 2 ;;
            esac
            shift 2
            ;;
        --resume|--repair|--rollback)
            [[ -z ${WASALIGHT_UPDATE_OPERATION:-} ]] || {
                _ "Only one recovery operation may be requested." >&2; printf '\n' >&2; exit 2;
            }
            export WASALIGHT_UPDATE_OPERATION=$1
            shift
            ;;
        -h|--help)
            _ "Usage: wasalight-update-terminal [--channel stable|debug] [--resume|--repair|--rollback] [--plugin ID]"
            printf '\n'
            exit 0
            ;;
        *) printf '%s: %s\n' "$( _ "Unknown option" )" "$1" >&2; exit 2 ;;
    esac
done
exec lxterminal --title="$( _ "Wasalight Update" )" \
    -e /usr/local/libexec/wasalight-update-session
