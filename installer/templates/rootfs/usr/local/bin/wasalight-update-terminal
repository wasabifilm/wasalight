#!/usr/bin/env bash
# Copyright 2026 Michele Moser
# SPDX-License-Identifier: Apache-2.0
set -Eeuo pipefail
. "${WASALIGHT_I18N_HELPER:-/usr/local/libexec/wasalight-i18n}"
session_args=()
while (($#)); do
    case $1 in
        --plugin)
            (($# >= 2)) || { _ "--plugin requires an ID" >&2; printf '\n' >&2; exit 2; }
            case $2 in
                companion|ssh|vnc) session_args+=(--plugin "$2") ;;
                *) printf '%s: %s\n' "$( _ "Unknown plugin" )" "$2" >&2; exit 2 ;;
            esac
            shift 2
            ;;
        --channel)
            (($# >= 2)) || { _ "--channel requires stable or debug" >&2; printf '\n' >&2; exit 2; }
            case $2 in
                stable|debug) session_args+=(--channel "$2") ;;
                *) printf '%s: %s\n' "$( _ "Unknown update channel" )" "$2" >&2; exit 2 ;;
            esac
            shift 2
            ;;
        --resume|--repair|--rollback)
            [[ -z ${session_operation:-} ]] || {
                _ "Only one recovery operation may be requested." >&2; printf '\n' >&2; exit 2;
            }
            session_operation=$1
            session_args+=("$1")
            shift
            ;;
        -h|--help)
            _ "Usage: wasalight-update-terminal [--channel stable|debug] [--resume|--repair|--rollback] [--plugin ID]"
            printf '\n'
            exit 0
            ;;
        *) printf '%s: %s\n' "$( _ "Unknown option" )" "$1" >&2; exit 2 ;;
    esac
done
# LXTerminal can reuse an already-running server process, whose environment
# predates this launcher. Pass validated options in the command itself so the
# selected channel cannot silently fall back to Stable.
printf -v session_command '%q ' \
    /usr/local/libexec/wasalight-update-session "${session_args[@]}"
exec lxterminal --title="$( _ "Wasalight Update" )" -e "$session_command"
