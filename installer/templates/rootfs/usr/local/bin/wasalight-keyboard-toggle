#!/usr/bin/env bash
# Copyright 2026 Michele Moser
# SPDX-License-Identifier: Apache-2.0
set -u
readonly i18n_helper=${WASALIGHT_I18N_HELPER:-/usr/local/libexec/wasalight-i18n}
. "$i18n_helper"

readonly runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
readonly lock_file="$runtime_dir/wasalight-keyboard.lock"

command -v onboard >/dev/null 2>&1 || {
    command -v notify-send >/dev/null 2>&1 && notify-send \
        --app-name=Wasalight --icon=input-keyboard \
        "$( _ "On-screen keyboard unavailable" )" \
        "$( _ "The Onboard package is not installed." )" || true
    exit 1
}

install -d -m 0700 "$runtime_dir"
exec 9>"$lock_file"
flock -n 9 || exit 0

onboard_window_id() {
    xwininfo -root -tree 2>/dev/null | awk '
        /"Onboard": \("onboard" "Onboard"\)/ { print $1; exit }'
}

onboard_is_visible() {
    local window_id
    window_id=$(onboard_window_id)
    [[ -n $window_id ]] || return 1
    xwininfo -id "$window_id" 2>/dev/null | \
        grep -Fq 'Map State: IsViewable'
}

stop_onboard() {
    pkill -TERM -u "$(id -u)" -x onboard 2>/dev/null || true
    # Onboard may interpret SIGTERM as "hide" and keep its Python process
    # alive.  Do not leave that invisible instance blocking the next launch.
    for _ in $(seq 1 20); do
        pgrep -u "$(id -u)" -x onboard >/dev/null 2>&1 || return 0
        sleep 0.1
    done
    pkill -KILL -u "$(id -u)" -x onboard 2>/dev/null || true
    for _ in $(seq 1 10); do
        pgrep -u "$(id -u)" -x onboard >/dev/null 2>&1 || return 0
        sleep 0.1
    done
    return 1
}

if pgrep -u "$(id -u)" -x onboard >/dev/null 2>&1; then
    if onboard_is_visible; then
        stop_onboard
        exit $?
    fi
    # Closing Onboard from its own X button can unmap the keyboard while the
    # process remains alive.  Clean up the hidden instance and reopen it in
    # this same touch instead of requiring a second press on the tray button.
    stop_onboard || exit 1
fi

onboard_args=()
[[ ! -r /usr/share/onboard/themes/Nightshade.theme ]] || \
    onboard_args+=(--theme=Nightshade)

# Wasalight controls Onboard exclusively through the fixed tint2 button. Its
# own status icon would appear beside that button while the pointer is still
# there, shift the panel and potentially hide the keyboard again. Auto-show is
# disabled too: visibility must not depend on focus or pointer position.
if command -v gsettings >/dev/null 2>&1; then
    gsettings set org.onboard show-status-icon false 2>/dev/null || true
    gsettings set org.onboard.auto-show enabled false 2>/dev/null || true
    # The XInput backend in Ubuntu 24.04 can crash when a virtual tablet and a
    # mouse are exposed together (notably in UTM/QEMU). GTK still supports
    # mouse and touchscreen input without binding directly to every XI device.
    gsettings set org.onboard.keyboard input-event-source GTK 2>/dev/null || true
    gsettings set org.onboard.window force-to-top true 2>/dev/null || true
    gsettings set org.onboard.window window-state-sticky true 2>/dev/null || true
    gsettings set org.onboard.window enable-inactive-transparency false \
        2>/dev/null || true
fi

# Pass the geometry at startup as well as through the later window-manager
# fallback. With the GTK input backend Onboard may deliberately omit its main
# window from the EWMH task list, making it invisible to wmctrl.
read -r screen_width screen_height < <(
    xdpyinfo 2>/dev/null | awk '
        /dimensions:/ {
            split($2, size, "x")
            print size[1], size[2]
            exit
        }'
)
if [[ ${screen_width:-} =~ ^[0-9]+$ && ${screen_height:-} =~ ^[0-9]+$ ]]; then
    width=$((screen_width * 90 / 100))
    height=$((screen_height * 38 / 100))
    x=$((screen_width * 5 / 100))
    y=$((screen_height - height - 64))
    ((y < 0)) && y=0
    onboard_args+=(--size="${width}x${height}" -x "$x" -y "$y")
fi
# Do not let the long-lived background process inherit the toggle lock. If it
# keeps descriptor 9 open, every later press sees the lock as busy and exits.
GTK_A11Y=none onboard "${onboard_args[@]}" 9>&- >/dev/null 2>&1 &

# Place the keyboard above the always-visible dock. Failure to position the
# window is harmless: Onboard remains usable with its own saved geometry.
for _ in $(seq 1 30); do
    window_id=$(onboard_window_id)
    if [[ -n ${window_id:-} ]] && onboard_is_visible; then
        if [[ ${screen_width:-} =~ ^[0-9]+$ && ${screen_height:-} =~ ^[0-9]+$ ]]; then
            wmctrl -i -r "$window_id" -e "0,$x,$y,$width,$height" || true
            wmctrl -i -r "$window_id" -b add,above,sticky || true
        fi
        exit 0
    fi
    sleep 0.1
done

exit 0
