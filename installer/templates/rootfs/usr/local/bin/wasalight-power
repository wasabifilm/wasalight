#!/usr/bin/env bash
# Copyright 2026 Michele Moser
# SPDX-License-Identifier: Apache-2.0
set -Eeuo pipefail
. /usr/local/libexec/wasalight-i18n

action=${1:-}
case "$action" in
    poweroff)
        title=$( _ "Power off Wasalight" )
        question=$( _ "Shut down the workstation completely?" )
        confirm=$( _ "Power off" )
        icon=wasalight-power
        ;;
    reboot)
        title=$( _ "Restart Wasalight" )
        question=$( _ "Restart the workstation now?" )
        confirm=$( _ "Restart" )
        icon=wasalight-reboot
        ;;
    *)
        _ "Usage: wasalight-power poweroff|reboot" >&2
        printf '\n' >&2
        exit 2
        ;;
esac

detail=$( _ "Shows saved in /data will remain persistent." )
cancel=$( _ "Cancel" )
/usr/local/bin/wasalight-dialog --question --icon="$icon" --width=460 --title="$title" \
    --text="<big><b>$question</b></big>\n\n$detail" \
    --ok-label="$confirm" --cancel-label="$cancel" || exit 0
sudo -n /usr/local/sbin/wasalight-power-control "$action"
