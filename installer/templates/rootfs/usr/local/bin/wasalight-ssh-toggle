#!/usr/bin/env bash
# Copyright 2026 Michele Moser
# SPDX-License-Identifier: Apache-2.0
set -Eeuo pipefail
. /usr/local/libexec/wasalight-i18n
[[ $(id -un) == chamsys ]] || {
    echo "Run this command as the chamsys desktop user." >&2
    exit 1
}

ip_address=$(hostname -I 2>/dev/null | awk '{print $1}')
if systemctl is-active --quiet ssh.service; then
    next_boot=""
    if [[ -r /data/system/service-flags/ssh-autostart && \
         $(</data/system/service-flags/ssh-autostart) == enabled ]]; then
        next_boot="\n\n$( _ "Note: SSH is configured to start again on the next boot." )"
    fi
    /usr/local/bin/wasalight-dialog --question \
        --icon=wasalight-ssh --width=500 --title="SSH · Wasalight" \
        --text="$(printf "$(_ '<big><b>SSH is active.</b></big>\n\nAddress: ssh://chamsys@%s:22%s\n\nStop SSH access now?')" "${ip_address:-SERVER_IP}" "$next_boot")" \
        --ok-label="$( _ "Stop SSH" )" --cancel-label="$( _ "Cancel" )" || exit 0
    output=$(sudo -n /usr/local/sbin/wasalight-ssh-control stop 2>&1) || {
        /usr/local/bin/wasalight-dialog --error --width=500 --title="SSH · Wasalight" --text="$output"
        exit 1
    }
    /usr/local/bin/wasalight-dialog --info --width=420 --title="SSH · Wasalight" --text="$output"
    exit 0
fi

/usr/local/bin/wasalight-dialog --question \
    --icon=wasalight-ssh --width=520 --title="SSH · Wasalight" \
    --text="$( _ '<big><b>Enable SSH?</b></big>\n\nAccess will use the chamsys account and its Linux password. Enable it only on a trusted network.' )" \
    --ok-label="$( _ "Start SSH" )" --cancel-label="$( _ "Cancel" )" || exit 0
output=$(sudo -n /usr/local/sbin/wasalight-ssh-control start 2>&1) || {
    /usr/local/bin/wasalight-dialog --error --width=500 --title="SSH · Wasalight" --text="$output"
    exit 1
}
ip_address=$(hostname -I 2>/dev/null | awk '{print $1}')
/usr/local/bin/wasalight-dialog --info --width=500 --title="SSH · Wasalight" \
    --text="$(printf "$(_ '<big><b>SSH active</b></big>\n\nAddress: ssh://chamsys@%s:22\nUser: chamsys\nPassword: the Linux password for chamsys')" "${ip_address:-SERVER_IP}")"
