#!/usr/bin/env bash
# Copyright 2026 Michele Moser
# SPDX-License-Identifier: Apache-2.0
set -Eeuo pipefail
. /usr/local/libexec/wasalight-i18n

title='Wasalight · Rollback'
if [[ $(findmnt -n -o FSTYPE / 2>/dev/null) == overlay ]]; then
    /usr/local/bin/wasalight-dialog --error --width=560 --title="$title" \
        --text="$( _ '<big><b>MAINTENANCE mode required.</b></big>\n\nSwitch to MAINTENANCE and reboot before restoring a snapshot.' )"
    exit 1
fi

snapshots=$(pkexec /usr/local/sbin/wasalight-rollback list)
if [[ -z $snapshots ]]; then
    /usr/local/bin/wasalight-dialog --info --width=520 --title="$title" \
        --text="$( _ "No Wasalight snapshot is available." )"
    exit 0
fi

rows=()
while IFS=$'\t' read -r file version stamp size integrity mode; do
    rows+=("$file" "$version" "$stamp" "$size" "$integrity")
done <<<"$snapshots"

selected=$(zenity --list --modal --width=820 --height=430 --title="$title" \
    --text="$( _ 'Select a Wasalight configuration to restore.\nMagicQ, Ubuntu packages and show data will not be changed.' )" \
    --column="$( _ "File" )" --column="$( _ "Version" )" --column="$( _ "Date" )" \
    --column="$( _ "Size" )" --column="Checksum" --hide-column=1 --print-column=1 \
    "${rows[@]}") || exit 0
[[ -n $selected ]] || exit 0

details=$(awk -F '\t' -v selected="$selected" \
    -v version="$( _ "Version:" )" -v date="$( _ "Date:" )" -v size="$( _ "Size:" )" \
    '$1 == selected {print version" "$2"\n"date" "$3"\n"size" "$4"\nChecksum: "$5}' <<<"$snapshots")
integrity=$(awk -F '\t' -v selected="$selected" '$1 == selected {print $5}' <<<"$snapshots")
set +e
action=$(/usr/local/bin/wasalight-dialog --question --icon=document-revert --width=620 --title="$title" \
    --text="$(printf "$(_ '<big><b>What do you want to do with this snapshot?</b></big>\n\n%s\n\nRestore replaces Wasalight configuration, commands and theme. Deletion is permanent.')" "$details")" \
    --ok-label="$( _ "Restore" )" --cancel-label="$( _ "Cancel" )" \
    --extra-button="$( _ "Delete snapshot" )")
action_rc=$?
set -e

if [[ $action == "$( _ "Delete snapshot" )" ]]; then
    if ! /usr/local/bin/wasalight-dialog --question --icon=edit-delete --width=600 --title="$title" \
        --text="$(printf "$(_ '<big><b>Permanently delete this snapshot?</b></big>\n\n%s\n\nThe file and its checksum will be removed from /data and cannot be recovered.')" "$details")" \
        --ok-label="$( _ "Delete permanently" )" --cancel-label="$( _ "Keep" )"; then
        exit 0
    fi
    if pkexec /usr/local/sbin/wasalight-rollback delete "$selected"; then
        /usr/local/bin/wasalight-dialog --info --width=520 --title="$title" \
            --text="$(printf "$(_ '<big><b>Snapshot deleted.</b></big>\n\n%s')" "$details")"
        exit 0
    fi
    /usr/local/bin/wasalight-dialog --error --width=560 --title="$title" \
        --text="$( _ '<big><b>Deletion failed.</b></big>\n\nThe snapshot was kept.' )"
    exit 1
fi
if ((action_rc != 0)); then
    exit 0
fi
if [[ $integrity != OK ]]; then
    /usr/local/bin/wasalight-dialog --error --width=560 --title="$title" \
        --text="$( _ '<big><b>Snapshot integrity check failed.</b></big>\n\nThe checksum is invalid, so restore was blocked. You can still delete the snapshot from the previous menu.' )"
    exit 1
fi

log_file=$(mktemp /tmp/wasalight-rollback.XXXXXX)
trap 'rm -f -- "$log_file"' EXIT
set +e
pkexec /usr/local/sbin/wasalight-rollback restore "$selected" >"$log_file" 2>&1 &
restore_pid=$!
(
    while kill -0 "$restore_pid" 2>/dev/null; do
        printf '# %s\n' "$( _ "Restoring configuration…" )"
        sleep 1
    done
) | zenity --progress --pulsate --auto-close --no-cancel --modal \
    --width=520 --title="$title" 2>/dev/null
wait "$restore_pid"
rc=$?
set -e

if ((rc != 0)); then
    details=$(tail -n 20 "$log_file")
    /usr/local/bin/wasalight-dialog --error --width=680 --title="$title" \
        --text="$(printf "$(_ '<big><b>Rollback failed.</b></big>\n\n%s')" "$details")"
    exit "$rc"
fi

if /usr/local/bin/wasalight-dialog --question \
    --icon=/usr/local/share/icons/wasalight/reboot.svg --width=560 --title="$title" \
    --text="$( _ '<big><b>Configuration restored.</b></big>\n\nRestart now to apply it?' )" \
    --ok-label="$( _ "Restart now" )" --cancel-label="$( _ "Later" )"; then
    sudo -n /usr/local/sbin/wasalight-power-control reboot
fi
