[Desktop Entry]
Type=Application
Name=System audit
Name[it]=Audit sistema
Comment=Analyze boot, services, ports and resources without changing the system
Comment[it]=Analizza avvio, servizi, porte e risorse senza modificare il sistema
Exec=/usr/local/bin/wasalight-terminal-tool audit
Icon=/usr/local/share/icons/wasalight/system-monitor.svg
TryExec=/usr/local/bin/wasalight-system-audit
X-Wasalight-Section=Support
X-Wasalight-Order=72
