[Desktop Entry]
Type=Application
Name=Art-Net Monitor
Name[it]=Monitor Art-Net
Comment=Show Art-Net sources, universes and packets in real time
Comment[it]=Mostra sorgenti, universi e pacchetti Art-Net in tempo reale
Exec=/usr/local/bin/wasalight-artnet-monitor
Icon=/usr/local/share/icons/wasalight/artnet-monitor.svg
TryExec=/usr/local/bin/wasalight-artnet-monitor
X-Wasalight-Section=Applications
X-Wasalight-Order=21
