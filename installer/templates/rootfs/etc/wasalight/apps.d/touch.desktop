[Desktop Entry]
Type=Application
Name=Touchscreen
Name[it]=Touchscreen
Comment=Show touch devices and display mapping
Comment[it]=Mostra dispositivi e associazione touch
Exec=/usr/local/bin/wasalight-terminal-tool touch
Icon=input-touchpad
TryExec=/usr/local/bin/wasalight-touch-status
X-Wasalight-Section=Support
X-Wasalight-Order=30
