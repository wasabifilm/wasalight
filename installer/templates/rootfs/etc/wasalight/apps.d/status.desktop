[Desktop Entry]
Type=Application
Name=System status
Name[it]=Stato sistema
Comment=Show the complete Wasalight status
Comment[it]=Mostra lo stato completo Wasalight
Exec=/usr/local/bin/wasalight-terminal-tool status
Icon=utilities-system-monitor
TryExec=/usr/local/bin/wasalight-status
X-Wasalight-Section=Support
X-Wasalight-Order=70
