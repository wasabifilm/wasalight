[Desktop Entry]
Type=Application
Name=System health
Name[it]=Salute sistema
Comment=Check disk, free space, memory and temperature
Comment[it]=Controlla disco, spazio, memoria e temperatura
Exec=/usr/local/bin/wasalight-terminal-tool health
Icon=utilities-system-monitor
TryExec=/usr/local/bin/wasalight-health
X-Wasalight-Section=Support
X-Wasalight-Order=71
